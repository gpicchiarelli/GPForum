#!/bin/sh
# SPDX-FileCopyrightText: 2026 Giacomo Picchiarelli
# SPDX-License-Identifier: BSD-3-Clause

set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)

runner="perltidy"

# Route through the project wrapper so the locked tree and the validated
# interpreter are used, instead of whatever happens to be on PATH.
if [ -d "$root/local" ]; then
    runner="$root/script/gpforum-carton exec perltidy"
fi

tmp_dir="${TMPDIR:-/tmp}/gpforum-perltidy-check.$$"
mkdir -p "$tmp_dir"
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM

file_list="$tmp_dir/files"
find bin lib t \
    -type f \( -path 'bin/*' -o -name '*.pm' -o -name '*.pl' -o -name '*.t' \) \
    > "$file_list" 2>/dev/null || true

# script/ holds a mix of shell and Perl. Both this gate and script/perlcritic
# select the Perl programs by shebang, so the two agree about which files the
# house style applies to. (This comment used to say script/perlcritic already
# read them; it did not, until it was changed to select them the same way.)
for candidate in script/*; do
    [ -f "$candidate" ] || continue
    if head -n 1 "$candidate" | grep -q 'perl'; then
        echo "$candidate" >> "$file_list"
    fi
done

if [ ! -s "$file_list" ]; then
    echo "No Perl files found."
    exit 0
fi

status=0

while IFS= read -r file; do
    formatted="$tmp_dir/formatted"
    if ! $runner -st --profile="$root/.perltidyrc" "$file" > "$formatted"; then
        echo "perltidy-check: failed to format $file" >&2
        status=1
        continue
    fi

    if ! cmp -s "$file" "$formatted"; then
        echo "perltidy-check: $file is not perltidy-clean" >&2
        status=1
    fi
done < "$file_list"

exit "$status"
