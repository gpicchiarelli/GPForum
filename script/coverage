#!/bin/sh
set -eu

gpforum_carton="$(CDPATH= cd -- "$(dirname "$0")" && pwd)/gpforum-carton"

if [ ! -d t ] || ! find t -type f -name '*.t' | grep -q .; then
    echo "No tests found."
    exit 0
fi

rm -rf cover_db
HARNESS_PERL_SWITCHES=-MDevel::Cover "$gpforum_carton" exec prove -lr t "$@"
exec "$gpforum_carton" exec -- cover -select_re '^(lib/GPForum|t)/'
