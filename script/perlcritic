#!/bin/sh
set -eu

runner="perlcritic"

if command -v carton >/dev/null 2>&1 && [ -d local ]; then
    runner="carton exec perlcritic"
fi

has_target=0
for argument in "$@"; do
    if [ -e "$argument" ]; then
        has_target=1
    fi
done

if [ "$has_target" -eq 1 ]; then
    exec $runner --profile .perlcriticrc "$@"
fi

tmp_file="${TMPDIR:-/tmp}/gpforum-perlcritic-files.$$"
trap 'rm -f "$tmp_file"' EXIT HUP INT TERM

find bin lib script t \
    -type f \( -path 'bin/*' -o -name '*.pm' -o -name '*.pl' -o -name '*.t' \) \
    > "$tmp_file" 2>/dev/null || true

if [ ! -s "$tmp_file" ]; then
    echo "No Perl files found."
    exit 0
fi

exec xargs $runner --profile .perlcriticrc "$@" < "$tmp_file"
