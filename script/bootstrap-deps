#!/bin/sh
# SPDX-FileCopyrightText: 2026 Giacomo Picchiarelli
# SPDX-License-Identifier: BSD-3-Clause

set -eu

# Install locked CPAN distributions through Carton under the OS system Perl.
# Production and CI use `carton install --deployment` against
# cpanfile.snapshot. This script does not install or switch to a non-system
# Perl; does not download from unsigned URLs; does not sideload application
# dists with cpanm; and does not delete local/.

root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
cd "$root"

perl_bin=$(script/gpforum-system-perl --require)
PATH="$(dirname "$perl_bin"):$PATH"
export PATH
printf 'bootstrap-deps: system perl -> %s\n' "$perl_bin"

with_postgres=0
production=0
update=0
cached=0
rebuild_local=0
for_setup=0
dry_run=0

usage() {
    cat <<'EOF'
Usage: script/bootstrap-deps [--postgres] [--production] [--update] [--cached] [--rebuild-local]
                             [--for-setup] [--dry-run]

  --postgres       include the cpanfile postgres feature (DBD::Pg, Mojo::Pg,
                   Test::PostgreSQL). Requires pg_config / libpq.
  --production     leave out the develop phase (Perl::Critic, Perl::Tidy,
                   Devel::Cover, Devel::NYTProf and what they pull in): what a
                   production host runs, per ADR 0109.
  --update         refresh cpanfile.snapshot (development lock update). Do not
                   use this on production hosts.
  --cached         install from vendor/cache after `carton bundle`.
  --rebuild-local  rename an existing local/ to local.rebuild.<epoch> then
                   reinstall (does not delete). Use when local/ is incomplete
                   or built for another Perl.
  --for-setup      what gpforum setup runs on a checkout without its
                   dependencies: say so first, and end with a line of
                   setup's kind instead of the next step, setup going on
  --dry-run        with --for-setup, say what it would install, install
                   nothing, and exit 1

Default production/CI path: carton install --deployment
HTTPS mirror: PERL_CARTON_MIRROR=https://cpan.metacpan.org/
EOF
}

for argument in "$@"; do
    case "$argument" in
        --postgres)
            with_postgres=1
            ;;
        --production)
            production=1
            ;;
        --update|--dev)
            update=1
            ;;
        --cached)
            cached=1
            ;;
        --rebuild-local)
            rebuild_local=1
            ;;
        --for-setup)
            for_setup=1
            ;;
        --dry-run)
            dry_run=1
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            echo "bootstrap-deps: unknown option: $argument" >&2
            usage >&2
            exit 1
            ;;
    esac
done

# A lock refresh without the develop phase would drop the maintainers' tools
# from cpanfile.snapshot for everyone.
if [ "$production" -eq 1 ] && [ "$update" -eq 1 ]; then
    echo "bootstrap-deps: --production cannot be combined with --update: the lock must keep the develop tools." >&2
    exit 2
fi

if [ ! -f cpanfile ]; then
    echo "bootstrap-deps: cpanfile is missing" >&2
    exit 1
fi

if [ ! -f cpanfile.snapshot ]; then
    if [ "$update" -eq 0 ]; then
        echo "bootstrap-deps: cpanfile.snapshot is required for --deployment." >&2
        echo "Refresh the lock on a development host with: script/bootstrap-deps --update" >&2
        exit 1
    fi
    echo "bootstrap-deps: no snapshot yet; carton install will create cpanfile.snapshot" >&2
fi

if [ "$with_postgres" -eq 1 ] && [ ! -f cpanfile.postgres ]; then
    echo "bootstrap-deps: cpanfile.postgres is missing" >&2
    exit 1
fi

current_perl=$("$perl_bin" -MConfig -e 'print $Config{version}')
if [ "$rebuild_local" -eq 1 ] && [ -e local ]; then
    stamp=$(date +%s)
    backup="local.rebuild.${stamp}"
    echo "bootstrap-deps: --rebuild-local moving local/ -> ${backup}"
    mv local "$backup"
fi
if [ -d local/lib/perl5 ]; then
    if ! "$perl_bin" -Ilocal/lib/perl5 -e '1' >/dev/null 2>&1; then
        echo "bootstrap-deps: local/ is not usable with system Perl $current_perl ($perl_bin)." >&2
        echo "Refusing to delete local/. Rebuild with: script/bootstrap-deps --postgres --rebuild-local" >&2
        echo "Or move local/ aside yourself." >&2
        exit 1
    fi
fi

find_pg_config() {
    if [ -n "${GPFORUM_PG_CONFIG:-}" ] && [ -x "${GPFORUM_PG_CONFIG}" ]; then
        printf '%s\n' "${GPFORUM_PG_CONFIG}"
        return 0
    fi
    if command -v pg_config >/dev/null 2>&1; then
        command -v pg_config
        return 0
    fi
    for candidate in \
        /opt/homebrew/opt/postgresql@18/bin/pg_config \
        /opt/homebrew/opt/postgresql@17/bin/pg_config \
        /opt/homebrew/opt/postgresql@16/bin/pg_config \
        /usr/local/opt/postgresql@18/bin/pg_config \
        /opt/homebrew/opt/libpq/bin/pg_config \
        /usr/local/opt/libpq/bin/pg_config \
        /Applications/Postgres.app/Contents/Versions/latest/bin/pg_config
    do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

if [ "$with_postgres" -eq 1 ]; then
    pg_config_bin=$(find_pg_config) || {
        echo "bootstrap-deps: pg_config is required for DBD::Pg." >&2
        echo "Run script/system-preflight for OS package guidance." >&2
        exit 1
    }
    PATH="$(dirname "$pg_config_bin"):$PATH"
    export PATH
    PG_CONFIG="$pg_config_bin"
    export PG_CONFIG
    printf 'bootstrap-deps: using pg_config -> %s\n' "$pg_config_bin"
fi

# Net::SSLeay, under IO::Socket::SSL, builds against OpenSSL's headers.
# Debian and Ubuntu install them under /usr with libssl-dev (libpq-dev does
# not bring it), FreeBSD has them in base; macOS has them only in Homebrew's
# keg-only openssl@3, which Net::SSLeay finds when OPENSSL_PREFIX names it.
if [ -z "${OPENSSL_PREFIX:-}" ] && [ ! -f /usr/include/openssl/ssl.h ]; then
    for candidate in /opt/homebrew/opt/openssl@3 /usr/local/opt/openssl@3; do
        if [ -f "$candidate/include/openssl/ssl.h" ]; then
            OPENSSL_PREFIX=$candidate
            export OPENSSL_PREFIX
            printf 'bootstrap-deps: using OpenSSL -> %s\n' "$candidate"
            break
        fi
    done
fi

if [ -z "${PERL_CARTON_MIRROR:-}" ]; then
    PERL_CARTON_MIRROR=https://cpan.metacpan.org/
fi
export PERL_CARTON_MIRROR

case "$PERL_CARTON_MIRROR" in
    https://*|file://*|/*)
        ;;
    *)
        echo "bootstrap-deps: PERL_CARTON_MIRROR must be HTTPS or a local path (got $PERL_CARTON_MIRROR)" >&2
        exit 1
        ;;
esac

set -- install
if [ "$update" -eq 0 ]; then
    set -- "$@" --deployment
fi
if [ "$cached" -eq 1 ]; then
    set -- "$@" --cached
fi
if [ "$with_postgres" -eq 0 ]; then
    set -- "$@" --without postgres
fi
if [ "$production" -eq 1 ]; then
    set -- "$@" --without develop
fi

snapshot_count() {
    if [ ! -f cpanfile.snapshot ]; then
        echo 0
        return
    fi
    grep -c '^  [A-Za-z0-9_.-]*$' cpanfile.snapshot || echo 0
}

# gpforum setup on a checkout without its dependencies runs this first
# (GPForum::CLI::FrontDoor::Carton): it says what it installs, as make
# install-deps-production would, in the operator's language.
if [ "$for_setup" -eq 1 ] && [ -r "$root/script/lib/words.sh" ]; then
    # shellcheck source=script/lib/words.sh
    . "$root/script/lib/words.sh"
    if [ "$production" -eq 1 ]; then
        make_target=install-deps-production
    else
        make_target=install-deps-postgres
    fi
    words_say system.deps_for_setup 'gpforum setup installs the dependencies into {local} first, as make {target} does: carton {command}' \
        "local=$root/local" "target=$make_target" "command=$*"
    if [ "$dry_run" -eq 1 ]; then
        words_say system.deps_dry_run 'Nothing was installed: --dry-run says what setup would do.'
        exit 1
    fi
fi

before_count=$(snapshot_count)
if [ "$update" -eq 1 ] && [ -f cpanfile.snapshot ]; then
    cp cpanfile.snapshot "${TMPDIR:-/tmp}/gpforum-cpanfile.snapshot.bak.$$"
fi

echo "bootstrap-deps: PERL_CARTON_MIRROR=$PERL_CARTON_MIRROR"
echo "bootstrap-deps: running carton $*"
script/gpforum-carton "$@"

after_count=$(snapshot_count)
if [ "$update" -eq 1 ] && [ "$before_count" -gt 20 ] && [ "$after_count" -lt "$before_count" ]; then
    echo "bootstrap-deps: carton install shrank cpanfile.snapshot from $before_count to $after_count distributions." >&2
    echo "Restoring the previous lock. Review local/ Perl compatibility and retry." >&2
    cp "${TMPDIR:-/tmp}/gpforum-cpanfile.snapshot.bak.$$" cpanfile.snapshot
    rm -f "${TMPDIR:-/tmp}/gpforum-cpanfile.snapshot.bak.$$"
    exit 1
fi
rm -f "${TMPDIR:-/tmp}/gpforum-cpanfile.snapshot.bak.$$"

echo "bootstrap-deps: verifying lock with carton check"
script/gpforum-carton check

# The interpreter shim script/gpforum-carton puts first on PATH lives in
# local/, and is made the first time a command runs. Made here, by whoever
# installs: the deployment guide keeps the code tree root's, and the service
# user, who cannot write local/, printed "mkdir: ... Permission denied" on
# every start and every command.
script/gpforum-carton exec perl -e 1

# What to type next, in the operator's language: a production host is set
# up, a development checkout's host checked, as the README goes on. A lock
# refresh is a maintainer's, with nothing after it.
if [ "$update" -eq 0 ] && [ -r "$root/script/lib/words.sh" ]; then
    # shellcheck source=script/lib/words.sh
    . "$root/script/lib/words.sh"
    echo
    if [ "${for_setup:-0}" -eq 1 ]; then
        words_mark ok "$(words_say system.deps_installed 'dependencies: installed into {local}, for Perl {version}' \
            "local=$root/local" "version=$current_perl")"
    elif [ "$production" -eq 1 ]; then
        words_say system.next_setup 'Next: set this host up, with sudo {gpforum} setup' \
            "gpforum=$root/bin/gpforum"
    else
        words_say system.next_preflight 'Next: check the host, with script/system-preflight'
    fi
fi
