#!/bin/sh
# SPDX-FileCopyrightText: 2026 Giacomo Picchiarelli
# SPDX-License-Identifier: BSD-3-Clause

set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
cd "$root"

missing=0

need() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "missing: $1"
        missing=1
    else
        printf 'ok: %s -> %s\n' "$1" "$(command -v "$1")"
    fi
}

if ! script/gpforum-system-perl --preflight; then
    echo "missing: system Perl 5.38+ (/usr/bin/perl, FreeBSD /usr/local, or Homebrew perl)"
    echo "Debian/Ubuntu: apt install perl build-essential cpanminus libpq-dev"
    echo "FreeBSD: pkg install perl5 p5-App-cpanminus postgresql16-client"
    echo "macOS (Homebrew): brew install perl postgresql@18; eval \"\$(script/gpforum-homebrew-env)\""
    missing=1
else
    perl_bin=$(script/gpforum-system-perl --print)
    PATH="$(dirname "$perl_bin"):$PATH"
    export PATH
fi

if [ ! -f cpanfile ]; then
    echo "missing: cpanfile"
    missing=1
else
    echo "ok: cpanfile"
fi

if [ ! -f cpanfile.snapshot ]; then
    echo "missing: cpanfile.snapshot"
    missing=1
else
    echo "ok: cpanfile.snapshot"
fi

if [ ! -f cpanfile.postgres ]; then
    echo "missing: cpanfile.postgres"
    missing=1
else
    echo "ok: cpanfile.postgres"
fi

if script/gpforum-carton version >/dev/null 2>&1; then
    printf 'ok: carton -> %s\n' "$(script/gpforum-carton version)"
    script/gpforum-carton exec perl -Ilib -MGPForum::Runtime -MGPForum::Service::Operations::OSPreflight -e 'my $runtime = GPForum::Runtime->new; my $os = $runtime->os_profile; my $preflight = GPForum::Service::Operations::OSPreflight->new(runtime => $runtime)->check; print "ok: gpforum_os -> ", $os->name, "\n"; print "ok: gpforum_event_backend -> ", $os->event_backend, "\n"; print "ok: gpforum_workers -> ", $os->recommended_worker_count, "\n"; print "ok: gpforum_os_preflight -> ", $preflight->{status}, "\n";'
else
    echo "missing: carton"
    echo "Install Carton for the system Perl with: cpanm -M https://cpan.metacpan.org/ Carton"
    missing=1
fi

# perlcritic is a develop dependency in local/, run through the wrapper
# like every other gate; a bare `perlcritic` on PATH is neither needed nor
# the one the gates use.
if script/gpforum-carton exec -- perlcritic --version >/dev/null 2>&1; then
    printf 'ok: perlcritic -> %s\n' "$(script/gpforum-carton exec -- perlcritic --version)"
else
    echo "missing: perlcritic (a develop dependency: script/bootstrap-deps without --production)"
    missing=1
fi

find_pg_config() {
    if [ -n "${GPFORUM_PG_CONFIG:-}" ] && [ -x "${GPFORUM_PG_CONFIG}" ]; then
        printf '%s\n' "${GPFORUM_PG_CONFIG}"
        return 0
    fi
    if command -v pg_config >/dev/null 2>&1; then
        command -v pg_config
        return 0
    fi
    for candidate in \
        /opt/homebrew/opt/postgresql@18/bin/pg_config \
        /opt/homebrew/opt/postgresql@17/bin/pg_config \
        /opt/homebrew/opt/postgresql@16/bin/pg_config \
        /usr/local/opt/postgresql@18/bin/pg_config \
        /opt/homebrew/opt/libpq/bin/pg_config \
        /usr/local/opt/libpq/bin/pg_config \
        /Applications/Postgres.app/Contents/Versions/latest/bin/pg_config
    do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

if pg_config_bin=$(find_pg_config); then
    printf 'ok: pg_config -> %s\n' "$pg_config_bin"
    "$pg_config_bin" --version
else
    echo "missing: pg_config"
    echo "Install PostgreSQL client development files before enabling the cpanfile postgres feature."
    echo "Debian/Ubuntu: apt install libpq-dev"
    echo "FreeBSD: pkg install postgresql16-client"
    echo "macOS (Homebrew): brew install postgresql@18; eval \"\$(script/gpforum-homebrew-env)\" then re-run preflight"
    missing=1
fi

if [ "$(uname -s 2>/dev/null || echo unknown)" = Darwin ] && command -v brew >/dev/null 2>&1; then
    if script/gpforum-homebrew-env --check >/dev/null 2>&1; then
        echo "ok: homebrew_pg -> $(script/gpforum-homebrew-env --print-path)"
    else
        echo "hint: macOS Homebrew detected; run eval \"\$(script/gpforum-homebrew-env)\" for psql/pg_dump/pg_config"
    fi
fi

exit "$missing"
