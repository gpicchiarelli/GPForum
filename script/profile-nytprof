#!/bin/sh
set -eu

usage='Usage:
  script/profile-nytprof --route /path [benchmark options]
  script/profile-nytprof -- perl-program [args...]'

if [ "$#" -eq 0 ] || [ "${1:-}" = "--help" ]; then
    echo "$usage"
    exit 0
fi

mkdir -p var/profile

if [ "$1" = "--route" ]; then
    if [ "$#" -lt 2 ]; then
        echo "$usage" >&2
        exit 2
    fi
    route="$2"
    shift 2
    export NYTPROF="${NYTPROF:-file=var/profile/route-nytprof.out:addpid=1}"
    exec carton exec perl -Ilib -d:NYTProf bin/gpforum-benchmark \
        --iterations 3 \
        --warmup 1 \
        --route "$route" \
        "$@"
fi

if [ "$1" = "--" ]; then
    shift
fi

export NYTPROF="${NYTPROF:-file=var/profile/nytprof.out:addpid=1}"
exec carton exec perl -d:NYTProf "$@"
