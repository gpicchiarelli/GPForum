[Unit]
Description=GPForum monthly partition window (ADR 0113)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=gpforum
Group=gpforum
WorkingDirectory=/opt/gpforum
# The mode, then the operator's settings. Every other setting keeps the
# default GPForum::Config gives it: a value restated here would stay behind
# when that default changes. Put an override in the env file.
Environment=GPFORUM_ENV=production
EnvironmentFile=/etc/gpforum/gpforum.env
# The command prints its result on stdout, which the journal keeps; the log
# path is for anything the application itself logs.
Environment=GPFORUM_LOG_PATH=/var/log/gpforum/partition-maintenance.log
# Creates the current month and the lookahead that are missing, by CREATE
# TABLE ... (LIKE ...) and ATTACH PARTITION, which leave reads and writes of
# the parent alone. A run that finds another holding the maintenance lock
# (a second node, a deploy's migrate) does nothing and exits 0. Exit 1 means
# a partition could not be made: see docs/ops/partition-maintenance.md.
# ATTACH needs the role that owns the partitioned tables, the one migrations
# run as: if gpforum.env names another, add an EnvironmentFile with its DSN.
# bin/gpforum finds the Perl and the dependencies this checkout installed.
ExecStart=/opt/gpforum/bin/gpforum partitions --apply
Nice=10
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/gpforum
