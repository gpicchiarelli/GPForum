[Unit]
Description=GPForum outbox dispatcher
After=network-online.target postgresql.service gpforum.service clamav-daemon.service
Wants=network-online.target

[Service]
Type=simple
User=gpforum
Group=gpforum
WorkingDirectory=/opt/gpforum
Environment=MOJO_MODE=production
Environment=GPFORUM_ENV=production
EnvironmentFile=/etc/gpforum/gpforum.env
# Hypnotoad daemonizes, and Mojo::Server::daemonize reopens STDERR on
# /dev/null before the workers fork, so a logger left on STDERR writes
# nowhere. An explicit path is what makes the log readable at 3am.
Environment=GPFORUM_LOG_PATH=/var/log/gpforum/outbox.log
# carton install --deployment does not create local/bin/carton.
ExecStart=/opt/gpforum/script/gpforum-carton exec /opt/gpforum/bin/gpforum-outbox-dispatch --loop --limit 100 --sleep 5
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/gpforum

LogsDirectory=gpforum
LogsDirectoryMode=0750

[Install]
WantedBy=multi-user.target
