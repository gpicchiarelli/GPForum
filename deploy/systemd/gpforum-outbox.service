[Unit]
Description=GPForum outbox dispatcher
After=network-online.target postgresql.service gpforum.service
Wants=network-online.target

[Service]
Type=simple
User=gpforum
Group=gpforum
WorkingDirectory=/opt/gpforum
Environment=MOJO_MODE=production
Environment=GPFORUM_ENV=production
ExecStart=/opt/gpforum/local/bin/carton exec /opt/gpforum/bin/gpforum-outbox-dispatch --loop --limit 100 --sleep 5
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/gpforum

[Install]
WantedBy=multi-user.target
