% layout 'default';
% title t('nav.privacy') . ' - ' . t('app.name');

<section aria-labelledby="privacy-dashboard-heading">
  <%= include 'components/page_header',
    heading_id => 'privacy-dashboard-heading',
    component_title => t('nav.privacy') %>

  <section aria-labelledby="privacy-export-heading">
    <%= include 'components/section_header',
      heading_id => 'privacy-export-heading',
      component_title => t('privacy.data_export') %>
    <form method="post" action="<%= url_for('privacy_export_request') %>">
      <%= csrf_field %>
      <input type="hidden" name="command_id" value="<%= $export_command_id || q{} %>">
      <button type="submit"><%= t('privacy.request_export') %></button>
    </form>

    % if (@{$export_requests}) {
      <ol class="ui-card-list" aria-label="<%= t('privacy.data_export_requests') %>">
        % for my $request (@{$export_requests}) {
          % my $counts = $request->{manifest}{counts} || {};
          <li class="ui-card-list__item">
            <article aria-labelledby="<%= $request->{ui}{heading_id} %>">
              <h3 id="<%= $request->{ui}{heading_id} %>"><%= ui_label('state', $request->{status}) %></h3>
              <p>
                <span><%= $request->{format} %></span>
                <time datetime="<%= $request->{created_at} %>"><%= dt($request->{created_at}) %></time>
              </p>
              % if (%{$counts}) {
                <p><%= t('data.posts') %> <%= $counts->{posts} || 0 %>, <%= t('data.attachments') %> <%= $counts->{attachments} || 0 %>, <%= t('data.notifications') %> <%= $counts->{notifications} || 0 %>, <%= t('data.subscriptions') %> <%= $counts->{subscriptions} || 0 %>.</p>
              % }
              % if (($request->{status} || q{}) eq 'completed') {
                <p><a href="<%= url_for('privacy_export_download', export_request_id => $request->{export_request_id}) %>"><%= t('privacy.download_export') %></a></p>
              % }
            </article>
          </li>
        % }
      </ol>
    % } else {
      <%= include 'components/empty_state',
        heading_id => 'privacy-export-empty-heading',
        component_title => t('privacy.no_export_requests') %>
    % }
  </section>

  <section aria-labelledby="privacy-deletion-heading">
    <%= include 'components/section_header',
      heading_id => 'privacy-deletion-heading',
      component_title => t('privacy.account_deletion') %>
    <form method="post" action="<%= url_for('privacy_deletion_request') %>">
      <%= csrf_field %>
      <input type="hidden" name="command_id" value="<%= $deletion_command_id || q{} %>">
      <label for="privacy-deletion-reason"><%= t('common.reason') %></label>
      <textarea id="privacy-deletion-reason" name="reason" required></textarea>
      <button type="submit"><%= t('privacy.request_deletion') %></button>
    </form>

    % if (@{$deletion_requests}) {
      <ol class="ui-card-list" aria-label="<%= t('privacy.account_deletion_requests') %>">
        % for my $request (@{$deletion_requests}) {
          <li class="ui-card-list__item">
            <article aria-labelledby="<%= $request->{ui}{heading_id} %>">
              <h3 id="<%= $request->{ui}{heading_id} %>"><%= ui_label('state', $request->{status}) %></h3>
              <p>
                <%= $request->{request_type} %>
                <time datetime="<%= $request->{created_at} %>"><%= dt($request->{created_at}) %></time>
              </p>
              % if ($request->{completed_at}) {
                <p><%= t('state.completed') %> <time datetime="<%= $request->{completed_at} %>"><%= dt($request->{completed_at}) %></time></p>
              % }
            </article>
          </li>
        % }
      </ol>
    % } else {
      <%= include 'components/empty_state',
        heading_id => 'privacy-deletion-empty-heading',
        component_title => t('privacy.no_deletion_requests') %>
    % }
  </section>

  % if (@{$active_holds}) {
    <section aria-labelledby="privacy-holds-heading">
      <%= include 'components/section_header',
        heading_id => 'privacy-holds-heading',
        component_title => t('privacy.retention_holds') %>
      <ol class="ui-card-list" aria-label="<%= t('privacy.active_retention_holds') %>">
        % for my $hold (@{$active_holds}) {
          <li class="ui-card-list__item">
            <strong><%= $hold->{resource_type} %></strong>
            <span><%= $hold->{reason} %></span>
            <time datetime="<%= $hold->{starts_at} %>"><%= dt($hold->{starts_at}) %></time>
          </li>
        % }
      </ol>
    </section>
  % }
</section>
