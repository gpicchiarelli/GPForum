% layout 'default', shell => 'wide';
% title t('admin.users') . ' - ' . t('app.name');

<section aria-labelledby="admin-users-heading">
  <%= include 'components/page_header',
    heading_id => 'admin-users-heading',
    component_title => t('admin.users'),
    actions_label => t('admin.users'),
    actions => ui_actions(
      { href => ui_path('admin_dashboard'), label => t('admin.admin') },
      { href => ui_path('admin_roles'), label => t('admin.roles') },
      { href => ui_path('admin_categories'), label => t('admin.categories') },
    ) %>

  <form class="filter-form" method="get" action="<%= ui_path('admin_users') %>">
    <div class="field">
      <label for="admin-user-status"><%= t('admin.status') %></label>
      <select id="admin-user-status" name="status">
      <option value="" <%= !$status ? 'selected' : '' %>><%= t('common.any') %></option>
      <option value="pending" <%= $status && $status eq 'pending' ? 'selected' : '' %>><%= ui_label('state', 'pending') %></option>
      <option value="active" <%= $status && $status eq 'active' ? 'selected' : '' %>><%= ui_label('state', 'active') %></option>
      <option value="suspended" <%= $status && $status eq 'suspended' ? 'selected' : '' %>><%= ui_label('state', 'suspended') %></option>
      </select>
    </div>
    <div class="filter-form__actions">
      <button type="submit"><%= t('common.filter') %></button>
    </div>
  </form>

  % if (@{$users}) {
    <div class="ui-table-wrap">
      <table class="ui-admin-table" aria-label="<%= t('admin.user_list') %>">
        <thead>
          <tr>
            <th scope="col"><%= t('auth.username') %></th>
            <th scope="col"><%= t('admin.display_name') %></th>
            <th scope="col"><%= t('admin.email') %></th>
            <th scope="col"><%= t('admin.status') %></th>
            <th scope="col"><%= t('admin.trust_level') %></th>
            <th scope="col"><%= t('common.created') %></th>
            <th scope="col"><span class="visually-hidden"><%= t('ui.actions') %></span></th>
          </tr>
        </thead>
        <tbody>
          % for my $user (@{$users}) {
            <tr>
              <th scope="row" id="<%= $user->{ui}{heading_id} %>"><%= $user->{username} %></th>
              <td><%= $user->{display_name} %></td>
              <td><%= $user->{email_normalized} %></td>
              <td><%= include 'components/status_badge', value => $user->{status} %></td>
              <td class="ui-count"><%= $user->{trust_level} %></td>
              <td><%= include 'components/timestamp', at => $user->{created_at} %></td>
              <td class="ui-row-links">
                <a href="<%= ui_path('admin_user_roles', user_id => $user->{id}) %>"><%= t('admin.roles') %></a>
                <a href="<%= url_for('admin_audit')->query(target_type => $user->{ui}{audit_link_target_type}, target_id => $user->{id}) %>"><%= t('admin.audit') %></a>
              </td>
            </tr>
          % }
        </tbody>
      </table>
    </div>
  % } else {
    <%= include 'components/empty_state',
      heading_id => 'admin-users-empty-heading',
      component_title => t('admin.no_users') %>
  % }
</section>
