<nav class="site-nav" aria-label="<%= t('nav.primary') %>">
  <a href="<%= url_for('categories') %>"><%= t('nav.categories') %></a>
  <a href="<%= url_for('new_thread') %>"><%= t('nav.start_thread') %></a>
  <a href="<%= url_for('forum_search') %>"><%= t('nav.search') %></a>
  % if (session('user_id')) {
    <a href="<%= url_for('bookmarks') %>"><%= t('nav.bookmarks') %></a>
    <a href="<%= url_for('feed') %>"><%= t('nav.feed') %></a>
    <a href="<%= url_for('notifications') %>"><%= t('nav.notifications') %></a>
    <a href="<%= url_for('privacy_dashboard') %>"><%= t('nav.privacy') %></a>
  % }
</nav>
