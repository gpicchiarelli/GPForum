<form class="theme-form" method="post" action="<%= url_for('theme_update') %>" aria-label="<%= t('theme.selector_label') %>">
  <%= csrf_field %>
  % if (session('user_id')) {
    <input type="hidden" name="command_id" value="<%= ui_command_id %>">
  % }
  <input type="hidden" name="return_to" value="<%= ui_return_to %>">
  <label for="theme-selector">
    <span><%= t('theme.choose') %></span>
    <select id="theme-selector" name="theme">
      % for my $option (@{ ui_theme_options() }) {
        <option value="<%= $option->{name} %>"<%= $option->{current} ? ' selected' : '' %>><%= $option->{label} %></option>
      % }
    </select>
  </label>
  <button type="submit"><%= t('theme.apply') %></button>
</form>
