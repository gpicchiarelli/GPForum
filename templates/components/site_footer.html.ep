<footer class="site-footer" aria-label="<%= t('layout.footer_label') %>">
  <div>
    <strong><%= t('app.name') %></strong>
    <span><%= t('layout.footer_tagline') %></span>
  </div>
  <nav aria-label="<%= t('layout.footer_help') %>">
    <a href="<%= ui_path('categories') %>"><%= t('nav.categories') %></a>
    <a href="<%= ui_path('forum_search') %>"><%= t('nav.search') %></a>
    <a href="<%= ui_path('legal_terms') %>"><%= t('layout.footer_terms') %></a>
    <a href="<%= ui_path('legal_privacy') %>"><%= t('layout.footer_privacy') %></a>
    <a href="<%= ui_path('legal_cookies') %>"><%= t('layout.footer_cookies') %></a>
    % if (session('user_id')) {
      <a href="<%= ui_path('privacy_dashboard') %>"><%= t('nav.your_data') %></a>
    % }
    <span><%= t('layout.footer_license') %></span>
  </nav>
  <div class="site-footer__preferences" role="group" aria-label="<%= t('layout.preferences') %>">
    <%= include 'components/locale_selector' %>
    <%= include 'components/theme_selector' %>
  </div>
</footer>
