% layout 'default';
% title t('auth.email_verify_request_title') . ' - ' . t('app.name');
% my $form_described_by = $ui->{described_by} || q{};

<section aria-labelledby="<%= $ui->{heading_id} %>">
  <h1 id="<%= $ui->{heading_id} %>"><%= t('auth.email_verify_request_title') %></h1>
  <%= include 'components/error_summary',
    summary_id => 'email-verify-request-error-summary',
    errors => $errors,
    fields => $error_fields %>
  <form method="post" action="<%= url_for('email_verify_request_submit') %>"<%== length $form_described_by ? ' aria-describedby="' . $form_described_by . '"' : q{} %>>
    <%= csrf_field %>
    % for my $field (@{$fields}) {
      <label for="<%= $field->{id} %>"><%= t($field->{label_key}) %></label>
      <input id="<%= $field->{id} %>" name="<%= $field->{name} %>" type="<%= $field->{type} %>" value="<%= $field->{value} %>" autocomplete="<%= $field->{autocomplete} %>"<%== $field->{error_attrs} %>>
      <%= include 'components/field_error', field_id => $field->{error_id}, message => $field->{error} %>
    % }
    <button type="submit"><%= t('auth.email_verify_request_submit') %></button>
  </form>
</section>
