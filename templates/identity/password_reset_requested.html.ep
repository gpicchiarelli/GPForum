% layout 'default';
% title t('auth.password_reset_requested_title') . ' - ' . t('app.name');

<section aria-labelledby="password-reset-requested-heading">
  <%= include 'components/page_header',
    heading_id => 'password-reset-requested-heading',
    component_title => t('auth.password_reset_requested_title') %>
  <%= include 'components/alert', tone => 'success', message => t('auth.password_reset_requested_status') %>
</section>
