% layout 'default';
% title t('profile.not_found_title') . ' - ' . t('app.name');

<section aria-labelledby="profile-not-found-heading">
  <%= include 'components/page_header',
    heading_id => 'profile-not-found-heading',
    component_title => t('profile.not_found_title') %>
  <%= include 'components/empty_state',
    heading_id => 'profile-not-found-message-heading',
    component_title => t('profile.not_found_message') %>
</section>
