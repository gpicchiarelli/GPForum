% layout 'default';
% title t('auth.password_reset_title') . ' - ' . t('app.name');
% my $form_described_by = $ui->{described_by} || q{};

<section aria-labelledby="<%= $ui->{heading_id} %>">
  <h1 id="<%= $ui->{heading_id} %>"><%= t('auth.password_reset_title') %></h1>
  % if ($errors->{reset}) {
    <%= include 'components/field_error', field_id => 'password-reset-form-error', message => $errors->{reset}, role => 'alert' %>
  % }
  <%= include 'components/error_summary',
    summary_id => 'password-reset-error-summary',
    errors => $errors,
    fields => $error_fields %>
  <form method="post" action="<%= url_for('password_reset_complete') %>"<%== length $form_described_by ? ' aria-describedby="' . $form_described_by . '"' : q{} %>>
    <%= csrf_field %>
    <input type="hidden" name="token" value="<%= $token %>">
    % for my $field (@{$fields}) {
      <label for="<%= $field->{id} %>"><%= t($field->{label_key}) %></label>
      <input id="<%= $field->{id} %>" name="<%= $field->{name} %>" type="password" autocomplete="<%= $field->{autocomplete} %>"<%== $field->{error_attrs} %>>
      <%= include 'components/field_error', field_id => $field->{error_id}, message => $field->{error} %>
    % }
    <button type="submit"><%= t('auth.password_reset_complete') %></button>
  </form>
</section>
