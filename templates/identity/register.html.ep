% layout 'default';
% title t('auth.register_title') . ' - ' . t('app.name');
% my $has_errors = keys %{$errors} ? 1 : 0;
% my $username_error_attrs = $errors->{username} ? ' aria-invalid="true" aria-describedby="register-username-error"' : q{};
% my $display_name_error_attrs = $errors->{display_name} ? ' aria-invalid="true" aria-describedby="register-display-name-error"' : q{};
% my $email_error_attrs = $errors->{email} ? ' aria-invalid="true" aria-describedby="register-email-error"' : q{};
% my $password_error_attrs = $errors->{password} ? ' aria-invalid="true" aria-describedby="register-password-error"' : q{};

<section aria-labelledby="register-heading">
  <h1 id="register-heading"><%= t('auth.register_title') %></h1>
  % if ($errors->{registration}) {
    <p id="register-form-error" class="field-error" role="alert"><%= $errors->{registration} %></p>
  % }
  % if ($has_errors) {
    <div id="register-error-summary" class="form-error-summary" role="alert" tabindex="-1">
      <p><%= t('form.error_summary') %></p>
      <ul>
        % if ($errors->{username}) {
          <li><a href="#register-username"><%= $errors->{username} %></a></li>
        % }
        % if ($errors->{display_name}) {
          <li><a href="#register-display-name"><%= $errors->{display_name} %></a></li>
        % }
        % if ($errors->{email}) {
          <li><a href="#register-email"><%= $errors->{email} %></a></li>
        % }
        % if ($errors->{password}) {
          <li><a href="#register-password"><%= $errors->{password} %></a></li>
        % }
      </ul>
    </div>
  % }
  <form method="post" action="<%= url_for('register_submit') %>"<%== $has_errors ? ' aria-describedby="register-error-summary"' : q{} %>>
    <%= csrf_field %>
    <label for="register-username">
      <%= t('auth.username') %>
    </label>
    <input id="register-username" name="username" value="<%= $values->{username} // q{} %>" autocomplete="username"<%== $username_error_attrs %>>
    % if ($errors->{username}) {
      <p id="register-username-error" class="field-error"><%= $errors->{username} %></p>
    % }
    <label for="register-display-name">
      <%= t('auth.display_name') %>
    </label>
    <input id="register-display-name" name="display_name" value="<%= $values->{display_name} // q{} %>" autocomplete="name"<%== $display_name_error_attrs %>>
    % if ($errors->{display_name}) {
      <p id="register-display-name-error" class="field-error"><%= $errors->{display_name} %></p>
    % }
    <label for="register-email">
      <%= t('auth.email') %>
    </label>
    <input id="register-email" name="email" value="<%= $values->{email_normalized} // q{} %>" autocomplete="email"<%== $email_error_attrs %>>
    % if ($errors->{email}) {
      <p id="register-email-error" class="field-error"><%= $errors->{email} %></p>
    % }
    <label for="register-password">
      <%= t('auth.password') %>
    </label>
    <input id="register-password" name="password" type="password" autocomplete="new-password"<%== $password_error_attrs %>>
    % if ($errors->{password}) {
      <p id="register-password-error" class="field-error"><%= $errors->{password} %></p>
    % }
    <button type="submit"><%= t('auth.create_account') %></button>
  </form>
</section>
