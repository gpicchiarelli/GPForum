% layout 'default';
% title t('auth.password_reset_completed_title') . ' - ' . t('app.name');

<section aria-labelledby="password-reset-completed-heading">
  <%= include 'components/page_header',
    heading_id => 'password-reset-completed-heading',
    component_title => t('auth.password_reset_completed_title') %>
  <%= include 'components/alert', tone => 'success', message => t('auth.password_reset_completed_status') %>
</section>
