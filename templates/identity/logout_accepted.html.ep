% layout 'default';
% title t('auth.logout_accepted_title') . ' - ' . t('app.name');

%# The answer to signing out is what happened, in the title, and where to go.
<section aria-labelledby="logout-accepted-heading">
  <%= include 'components/page_header',
    heading_id => 'logout-accepted-heading',
    component_title => t('auth.logout_accepted_title'),
    actions_label => t('auth.logout_next_steps'),
    actions => ui_actions(
      { class => 'button', href => ui_path('categories'), label => t('forum.browse_categories') },
      { href => ui_path('login'), label => t('auth.login_again') },
    ) %>
</section>
