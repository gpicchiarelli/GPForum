% layout 'default';
% title $thread->{title} . ' - ' . t('app.name');
% stash breadcrumbs => [
%   { current => 0, label => t('nav.home'), url => url_for('home')->to_string },
%   { current => 0, label => t('nav.categories'), url => url_for('categories')->to_string },
%   { current => 0, label => $thread->{category_title} // t('forum.back_to_category'),
%     url => url_for('category', category_id => $thread->{category_id})->to_string },
%   { current => 1, label => $thread->{title} },
% ];
% my $can_reply = !$thread->{deleted_at} && !$thread->{locked_at};

<article class="thread" aria-labelledby="thread-heading">
  <header class="thread__header">
    <%= include 'components/page_header',
      heading_id => 'thread-heading',
      component_title => $thread->{title} %>
    % my $unread = $reading && $reading->{authenticated} && $reading->{first_unread_anchor};
    % if ($thread->{author_username} || $unread) {
      <p class="ui-meta">
        % if ($thread->{author_username}) {
          <span>
            <%= t('forum.started_by') %>
            <a href="<%= url_for('profile', username => $thread->{author_username}) %>"><%= $thread->{author_display_name} || $thread->{author_profile_label} %></a>
          </span>
        % }
        % if ($unread) {
          <span><a class="ui-meta__jump" href="#<%= $unread %>"><%= t('community.jump_to_first_unread') %></a></span>
        % }
      </p>
    % }
    <%= include 'forum/_thread_tools', can_reply => $can_reply %>
  </header>
  % if ($thread->{locked_at}) {
    <%= include 'components/alert', tone => 'warning', message => t('forum.thread_locked') %>
  % }
  % if ($thread->{deleted_at}) {
    <p role="status"><%= t('forum.thread_deleted_notice') %></p>
  % }
  % if ($thread->{can_restore_thread}) {
    <form method="post" action="<%= url_for('thread_restore', thread_id => $thread->{thread_id}) %>">
      <%= csrf_field %>
      <input type="hidden" name="command_id" value="<%= $thread->{restore_thread_command_id} || q{} %>">
      <button type="submit" class="button--secondary"><%= t('forum.restore_thread') %></button>
    </form>
  % }
  <section aria-labelledby="posts-heading">
    <h2 class="visually-hidden" id="posts-heading"><%= t('forum.posts') %></h2>
    % if (@{$posts}) {
      <ol class="ui-card-list">
        % for my $post (@{$posts}) {
          <li class="ui-card-list__item">
            <%= include 'forum/_post', post => $post %>
          </li>
        % }
      </ol>
    % } else {
      <%= include 'components/empty_state',
        heading_id => 'posts-empty-heading',
        component_title => t('forum.no_visible_posts') %>
    % }
    % if ($next_cursor) {
      <%= include 'components/pagination',
        label => t('forum.post_pagination'),
        items => ui_next_page(
          href => url_for('thread', thread_id => $thread->{thread_id})->query(after => $next_cursor),
          label => t('forum.next_posts'),
        ) %>
    % }
  </section>
  % if ($can_reply) {
    <section class="composer" aria-labelledby="reply-heading">
      <h2 id="reply-heading"><%= t('forum.reply') %></h2>
      <form method="post" action="<%= url_for('reply_create', thread_id => $thread->{thread_id}) %>">
        <%= csrf_field %>
        <input type="hidden" name="command_id" value="<%= $reply_command_id || q{} %>">
        <label class="visually-hidden" for="reply-body"><%= t('forum.reply_body') %></label>
        <textarea id="reply-body" name="body_source" rows="8" required></textarea>
        <button type="submit"><%= t('forum.post_reply') %></button>
      </form>
    </section>
  % }
</article>
