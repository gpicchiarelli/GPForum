% layout 'default';
% title $thread->{title} . ' - ' . t('app.name');

<article aria-labelledby="thread-heading">
  <p class="ui-meta"><a href="<%= url_for('category', category_id => $thread->{category_id}) %>"><%= t('forum.back_to_category') %></a></p>
  <%= include 'components/page_header',
    heading_id => 'thread-heading',
    component_title => $thread->{title} %>
  % if ($thread->{author_username}) {
    <p class="ui-meta">
      <%= t('forum.started_by') %>
      <a href="<%= url_for('profile', username => $thread->{author_username}) %>"><%= $thread->{author_profile_label} || $thread->{author_display_name} %></a>
    </p>
  % }
  % if ($thread->{locked_at}) {
    <%= include 'components/alert', tone => 'warning', message => t('forum.thread_locked') %>
  % }
  % if ($reading && $reading->{authenticated}) {
    <section aria-labelledby="reading-heading">
      <%= include 'components/section_header',
        heading_id => 'reading-heading',
        component_title => t('forum.reading_progress') %>
      % if ($reading->{first_unread_anchor}) {
        <p><a href="#<%= $reading->{first_unread_anchor} %>"><%= t('community.jump_to_first_unread') %></a></p>
      % } else {
        <%= include 'components/alert', tone => 'success', message => t('forum.reading_caught_up') %>
      % }
      <form method="post" action="<%= url_for('thread_mark_read', thread_id => $thread->{thread_id}) %>">
        <%= csrf_field %>
        <input type="hidden" name="last_read_position" value="<%= $reading->{last_visible_position} // 0 %>">
        <button type="submit"><%= t('forum.mark_visible_posts_read') %></button>
      </form>
    </section>
  % }
  % if ($engagement && $engagement->{authenticated}) {
    <section aria-labelledby="engagement-heading">
      <%= include 'components/section_header',
        heading_id => 'engagement-heading',
        component_title => t('forum.thread_tools') %>
      % my $bookmark = $engagement->{bookmark} || {};
      % my $subscription = $engagement->{subscription} || {};
      % if ($bookmark->{bookmarked}) {
        <form method="post" action="<%= url_for('thread_bookmark_remove', thread_id => $thread->{thread_id}) %>">
          <%= csrf_field %>
          <button type="submit"><%= t('community.remove_bookmark') %></button>
        </form>
      % } else {
        <form method="post" action="<%= url_for('thread_bookmark', thread_id => $thread->{thread_id}) %>">
          <%= csrf_field %>
          <label for="bookmark-note"><%= t('community.bookmark_note') %></label>
          <input id="bookmark-note" name="note" type="text" value="">
          <button type="submit"><%= t('community.save_bookmark') %></button>
        </form>
      % }
      % if ($subscription->{subscribed}) {
        <form method="post" action="<%= url_for('thread_unsubscribe', thread_id => $thread->{thread_id}) %>">
          <%= csrf_field %>
          <button type="submit"><%= t('community.unfollow_thread') %></button>
        </form>
        % if (!$subscription->{muted}) {
          <form method="post" action="<%= url_for('thread_subscription_mute', thread_id => $thread->{thread_id}) %>">
            <%= csrf_field %>
            <button type="submit"><%= t('community.mute_notifications') %></button>
          </form>
        % }
      % } else {
        <form method="post" action="<%= url_for('thread_subscribe', thread_id => $thread->{thread_id}) %>">
          <%= csrf_field %>
          <input type="hidden" name="preference" value="all">
          <button type="submit"><%= t('community.follow_thread') %></button>
        </form>
      % }
      <form method="post" action="<%= url_for('thread_report', thread_id => $thread->{thread_id}) %>">
        <%= csrf_field %>
        <label for="thread-report-reason"><%= t('moderation.report_thread') %></label>
        <select id="thread-report-reason" name="reason" required>
          <option value="spam"><%= t('moderation.reason.spam') %></option>
          <option value="abuse"><%= t('moderation.reason.abuse') %></option>
          <option value="privacy"><%= t('moderation.reason.privacy') %></option>
          <option value="other"><%= t('moderation.reason.other') %></option>
        </select>
        <label for="thread-report-details"><%= t('common.details') %></label>
        <textarea id="thread-report-details" name="details" rows="3"></textarea>
        <button type="submit"><%= t('moderation.submit_report') %></button>
      </form>
    </section>
  % }
  <section aria-labelledby="posts-heading">
    <%= include 'components/section_header',
      heading_id => 'posts-heading',
      component_title => t('forum.posts') %>
    % if (@{$posts}) {
      <ol class="ui-card-list">
        % for my $post (@{$posts}) {
          <li class="ui-card-list__item">
            <article id="post-<%= $post->{post_id} %>" aria-labelledby="post-<%= $post->{post_id} %>-heading">
              <h3 id="post-<%= $post->{post_id} %>-heading"><%= t('forum.post_number', { position => $post->{position} }) %></h3>
              % if ($post->{author_username}) {
                <p class="ui-meta">
                  <%= t('forum.by_author') %>
                  <a href="<%= url_for('profile', username => $post->{author_username}) %>"><%= $post->{author_profile_label} || $post->{author_display_name} %></a>
                </p>
              % }
              <p><a href="#post-<%= $post->{post_id} %>"><%= t('forum.permalink') %></a></p>
              <div><%== ui_trusted_html($post->{body}, 'forum.post.body') %></div>
              % if ($post->{attachments} && @{ $post->{attachments} }) {
                <ul aria-label="<%= t('forum.post_attachments') %>">
                  % for my $attachment (@{ $post->{attachments} }) {
                    <li>
                      <a href="<%= url_for('attachment_download', attachment_id => $attachment->{attachment_id}) %>"><%= $attachment->{original_filename} %></a>
                      <span><%= $attachment->{media_type} %></span>
                    </li>
                  % }
                </ul>
              % }
              % if ($engagement && $engagement->{authenticated}) {
                <form method="post" enctype="multipart/form-data" action="<%= url_for('post_attachment_upload', post_id => $post->{post_id}) %>">
                  <%= csrf_field %>
                  <label for="post-<%= $post->{post_id} %>-attachment"><%= t('form.attach_file') %></label>
                  <input id="post-<%= $post->{post_id} %>-attachment" name="attachment" type="file" required>
                  <button type="submit"><%= t('form.upload_attachment') %></button>
                </form>
                <form method="post" action="<%= url_for('post_report', post_id => $post->{post_id}) %>">
                  <%= csrf_field %>
                  <label for="post-<%= $post->{post_id} %>-report-reason"><%= t('moderation.report_post') %></label>
                  <select id="post-<%= $post->{post_id} %>-report-reason" name="reason" required>
                    <option value="spam"><%= t('moderation.reason.spam') %></option>
                    <option value="abuse"><%= t('moderation.reason.abuse') %></option>
                    <option value="privacy"><%= t('moderation.reason.privacy') %></option>
                    <option value="other"><%= t('moderation.reason.other') %></option>
                  </select>
                  <label for="post-<%= $post->{post_id} %>-report-details"><%= t('common.details') %></label>
                  <textarea id="post-<%= $post->{post_id} %>-report-details" name="details" rows="3"></textarea>
                  <button type="submit"><%= t('moderation.submit_report') %></button>
                </form>
              % }
            </article>
          </li>
        % }
      </ol>
    % } else {
      <%= include 'components/empty_state',
        heading_id => 'posts-empty-heading',
        component_title => t('forum.no_visible_posts') %>
    % }
    % if ($next_cursor) {
      <%= include 'components/pagination',
        label => t('forum.post_pagination'),
        items => ui_next_page(
          href => url_for('thread', thread_id => $thread->{thread_id})->query(after => $next_cursor),
          label => t('forum.next_posts'),
        ) %>
    % }
  </section>
  <section aria-labelledby="reply-heading">
    <%= include 'components/section_header',
      heading_id => 'reply-heading',
      component_title => t('forum.reply') %>
    <form method="post" action="<%= url_for('reply_create', thread_id => $thread->{thread_id}) %>">
      <%= csrf_field %>
      <input type="hidden" name="command_id" value="<%= $reply_command_id || q{} %>">
      <label for="reply-body"><%= t('forum.reply_body') %></label>
      <textarea id="reply-body" name="body_source" rows="8" required></textarea>
      <input type="hidden" name="visibility" value="<%= $thread->{visibility} // 'public' %>">
      <button type="submit"><%= t('forum.post_reply') %></button>
    </form>
  </section>
</article>
