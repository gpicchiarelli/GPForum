% layout 'default';
% title t('search.title') . ' - ' . t('app.name');

<section aria-labelledby="search-heading">
  <%= include 'components/page_header', heading_id => 'search-heading', component_title => t('search.title'), description => t('search.help'), description_id => 'search-help' %>
  % my $active_filters = $filters || {};
  % my $current_limit = $limit || 20;
  % my $result_count = scalar @{$results};
  % my $dated = grep { length($active_filters->{$_} // q{}) } qw(from to);
  % my @scoped = grep { length($active_filters->{$_} // q{}) } qw(category_id author_user_id);
  <form class="search-form" method="get" action="<%= ui_path('forum_search') %>" role="search" aria-describedby="search-help">
    <div class="search-form__bar">
      <label class="visually-hidden" for="search-query"><%= t('search.query') %></label>
      <input id="search-query" name="q" type="search" value="<%= $query // q{} %>" autocomplete="off">
      <button type="submit"><%= t('search.submit') %></button>
    </div>
    % for my $name (@scoped) {
      <input type="hidden" name="<%= $name %>" value="<%= $active_filters->{$name} %>">
    % }
    % if (@scoped) {
      % my %unscoped = (q => $query, map { $_ => $active_filters->{$_} } grep { length($active_filters->{$_} // q{}) } qw(from to));
      <p class="ui-meta">
        % if (length($active_filters->{category_id} // q{})) {
          <span><%= t('search.within_category') %></span>
        % }
        % if (length($active_filters->{author_user_id} // q{})) {
          <span><%= t('search.by_one_author') %></span>
        % }
        <span><a href="<%= url_for('forum_search')->query(%unscoped) %>"><%= t('search.search_everywhere') %></a></span>
      </p>
    % }
    <details<%= $dated ? ' open' : q{} %>>
      <summary><%= t('search.filters') %></summary>
      <fieldset>
        <legend class="visually-hidden"><%= t('search.filters') %></legend>
        <label for="search-from"><%= t('search.from') %></label>
        <input id="search-from" name="from" type="date" value="<%= $active_filters->{from} // q{} %>">
        <label for="search-to"><%= t('search.to') %></label>
        <input id="search-to" name="to" type="date" value="<%= $active_filters->{to} // q{} %>">
      </fieldset>
    </details>
    <input type="hidden" name="limit" value="<%= $current_limit %>">
  </form>
  % if ($degraded) {
    <%= include 'components/status_banner',
      tone => 'warning',
      heading_id => 'search-status-heading',
      component_title => t('search.title'),
      message => t('search.degraded') %>
  % }
  % if (@{$results}) {
    <p class="ui-meta" role="status"><span class="ui-count"><%= t('search.results_summary', { count => $result_count }) %></span></p>
    <ol class="ui-card-list" aria-label="<%= t('search.results') %>">
      % for my $result (@{$results}) {
        % my $is_thread = ($result->{entity_type} || q{}) eq 'thread';
        % my $thread_id = $is_thread ? $result->{entity_id} : $result->{thread_id};
        <li class="ui-card-list__item ui-row">
          <h2 class="ui-row__title">
            % if ($thread_id) {
              <a href="<%= ui_path('thread', thread_id => $thread_id) %><%= $is_thread ? q{} : '#post-' . $result->{entity_id} %>"><%= $result->{title} %></a>
            % } else {
              <%= $result->{title} %>
            % }
          </h2>
          <p>
            % if ($result->{snippet_html}) {
              <%== ui_trusted_html($result->{snippet_html}, 'search.snippet') %>
            % } else {
              <%= $result->{snippet} || $result->{body} %>
            % }
          </p>
          <p class="ui-meta">
            % if ($result->{author_username}) {
              <span>
                <%= t('search.by_author') %>
                <a href="<%= ui_path('profile', username => $result->{author_username}) %>"><%= $result->{author_display_name} || $result->{author_profile_label} %></a>
              </span>
            % }
            % if ($result->{source_created_at}) {
              <span><%= include 'components/timestamp', at => $result->{source_created_at} %></span>
            % }
          </p>
        </li>
      % }
    </ol>
    % if ($ranking_capped) {
      <p class="ui-note" id="search-ranking-capped"><%= t('search.ranking_capped', { limit => $candidate_limit }) %></p>
    % }
    <p class="ui-note"><%= t('search.permission_note') %></p>
    % if ($has_more && $more_limit) {
      % my %next_params = (q => $query, %{$active_filters}, limit => $more_limit);
      <%= include 'components/pagination', label => t('search.pagination'), items => ui_next_page(href => url_for('forum_search')->query(map { ($_ => $next_params{$_}) } sort keys %next_params), label => t('search.more_results')) %>
    % }
  % } elsif ($degraded) {
    %# The banner above says why there are no results; "no match" would be wrong.
  % } elsif (defined $query && length $query) {
    <%= include 'components/empty_state', heading_id => 'search-no-results-heading', component_title => t('search.no_results'), description => t('search.no_results_guidance') %>
  % } else {
    <%= include 'components/empty_state', heading_id => 'search-empty-heading', component_title => t('search.empty_title'), description => t('search.empty_guidance') %>
  % }
</section>
