%# One post of a thread: who wrote it and when, what they wrote, and what the
%# reader may do with it. Editing, deleting and reporting each open in a
%# sheet, so the page stays the conversation.
%#
%# Takes "post"; reads the page's "engagement".
% my $dom_id = 'post-' . $post->{post_id};
% my $ordinal = '#' . $post->{position};
% my $signed_in = $engagement && $engagement->{authenticated};

<article class="post" id="<%= $dom_id %>" aria-labelledby="<%= $dom_id %>-heading">
  <h3 class="visually-hidden" id="<%= $dom_id %>-heading"><%= t('forum.post_number', { position => $post->{position} }) %></h3>
  <span class="avatar avatar--<%= $post->{author_tint} %> post__avatar" aria-hidden="true"><%= $post->{author_initial} %></span>
  <header class="post__header">
    <p class="ui-meta post__byline">
      % if ($post->{author_username}) {
        <a class="post__author" href="<%= url_for('profile', username => $post->{author_username}) %>"><%= $post->{author_display_name} || $post->{author_profile_label} %></a>
        % if ($post->{author_display_name}) {
          <span><%= $post->{author_profile_label} %></span>
        % }
      % }
      % if ($post->{created_at}) {
        <span><%= include 'components/timestamp', at => $post->{created_at} %></span>
      % }
    </p>
    <a class="post__permalink" href="#<%= $dom_id %>" aria-label="<%= t('forum.permalink') %> <%= $ordinal %>"><%= $ordinal %></a>
  </header>
  <div class="forum-post-body"><%== ui_trusted_html($post->{body}, 'forum.post.body') %></div>
  % if ($post->{deleted_at}) {
    <p role="status"><%= t('forum.post_deleted_notice') %></p>
  % }
  % if ($post->{attachments} && @{ $post->{attachments} }) {
    <ul class="post__attachments" aria-label="<%= t('forum.post_attachments') %>">
      % for my $attachment (@{ $post->{attachments} }) {
        <li>
          <a href="<%= url_for('attachment_download', attachment_id => $attachment->{attachment_id}) %>"><%= $attachment->{original_filename} %></a>
          <span><%= $attachment->{media_type} %></span>
          % if ($post->{can_edit}) {
            <form method="post" action="<%= url_for('post_attachment_delete', post_id => $post->{post_id}, attachment_id => $attachment->{attachment_id}) %>">
              <%= csrf_field %>
              <input type="hidden" name="command_id" value="<%= $attachment->{delete_command_id} || q{} %>">
              <button type="submit" class="button--quiet"><%= t('forum.delete_attachment') %></button>
            </form>
          % }
        </li>
      % }
    </ul>
  % }
  % if ($post->{can_edit} || $post->{can_delete} || $post->{can_restore} || $signed_in) {
    <footer class="post__actions">
      % if ($post->{can_edit}) {
        <button type="button" class="button--quiet" popovertarget="<%= $dom_id %>-edit"><%= t('forum.edit_post') %></button>
        <%= include 'components/sheet', sheet_id => "$dom_id-edit", component_title => t('forum.edit_post') . " $ordinal", sheet_body => begin %>
          <form method="post" action="<%= url_for('post_edit', post_id => $post->{post_id}) %>">
            <%= csrf_field %>
            <input type="hidden" name="command_id" value="<%= $post->{edit_command_id} || q{} %>">
            <label for="<%= $dom_id %>-edit-body"><%= t('forum.edit_body') %></label>
            <textarea id="<%= $dom_id %>-edit-body" name="body_source" rows="10" required><%= $post->{body_source} %></textarea>
            <button type="submit"><%= t('forum.save_edit') %></button>
          </form>
          <form method="post" enctype="multipart/form-data" action="<%= url_for('post_attachment_upload', post_id => $post->{post_id}) %>">
            <%= csrf_field %>
            <input type="hidden" name="command_id" value="<%= $post->{upload_command_id} || q{} %>">
            <label for="<%= $dom_id %>-attachment"><%= t('form.attach_file') %></label>
            <input id="<%= $dom_id %>-attachment" name="attachment" type="file" required>
            <button type="submit" class="button--secondary"><%= t('form.upload_attachment') %></button>
          </form>
        <% end %>
      % }
      % if ($post->{can_delete}) {
        <button type="button" class="button--quiet" popovertarget="<%= $dom_id %>-delete"><%= t('forum.delete_post') %></button>
        <%= include 'components/sheet', sheet_id => "$dom_id-delete", component_title => t('forum.delete_post') . " $ordinal", sheet_body => begin %>
          <form method="post" action="<%= url_for('post_delete', post_id => $post->{post_id}) %>">
            <%= csrf_field %>
            <input type="hidden" name="command_id" value="<%= $post->{delete_command_id} || q{} %>">
            <p class="sheet__consequence"><%= t('forum.delete_post_consequence') %></p>
            <button type="submit" class="button--danger"><%= t('forum.delete_post') %></button>
          </form>
        <% end %>
      % }
      % if ($post->{can_restore}) {
        <form method="post" action="<%= url_for('post_restore', post_id => $post->{post_id}) %>">
          <%= csrf_field %>
          <input type="hidden" name="command_id" value="<%= $post->{restore_command_id} || q{} %>">
          <button type="submit" class="button--quiet"><%= t('forum.restore_post') %></button>
        </form>
      % }
      % if ($signed_in) {
        <button type="button" class="button--quiet" popovertarget="<%= $dom_id %>-report"><%= t('moderation.report_post') %></button>
        <%= include 'components/sheet', sheet_id => "$dom_id-report", component_title => t('moderation.report_post') . " $ordinal", sheet_body => begin %>
          <%= include 'forum/_report_form',
            post_to => url_for('post_report', post_id => $post->{post_id}),
            command_id => $post->{report_command_id},
            field_id => "$dom_id-report" %>
        <% end %>
      % }
    </footer>
  % }
</article>
