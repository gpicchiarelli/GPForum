% layout 'default';
% title 'Bookmarks - GPForum';

<main aria-labelledby="bookmarks-heading">
  <h1 id="bookmarks-heading">Bookmarks</h1>
  % if (@{$bookmarks}) {
    <ol>
      % for my $bookmark (@{$bookmarks}) {
        <li>
          <article aria-labelledby="bookmark-<%= $bookmark->{bookmark_id} %>-heading">
            <h2 id="bookmark-<%= $bookmark->{bookmark_id} %>-heading">
              <a href="<%= url_for('thread', thread_id => $bookmark->{target_id}) %>">
                Thread <%= $bookmark->{target_id} %>
              </a>
            </h2>
            % if (length($bookmark->{note} // q{})) {
              <p><%= $bookmark->{note} %></p>
            % }
            <p>Saved at <time datetime="<%= $bookmark->{created_at} %>"><%= $bookmark->{created_at} %></time></p>
          </article>
        </li>
      % }
    </ol>
  % } else {
    <p>No bookmarks saved yet.</p>
  % }
  % if ($next_cursor) {
    <nav aria-label="Bookmark pagination">
      <a href="<%= url_for('bookmarks')->query(after => $next_cursor) %>">Older bookmarks</a>
    </nav>
  % }
</main>
