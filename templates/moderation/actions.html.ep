% layout 'default';
% title t('moderation.actions') . ' - ' . t('app.name');

<section aria-labelledby="moderation-actions-heading">
  <%= include 'components/page_header',
    heading_id => 'moderation-actions-heading',
    component_title => t('moderation.actions') %>
  <form method="get" action="<%= url_for('moderation_actions') %>">
    <label for="action-target-type"><%= t('common.target_type') %></label>
    <select id="action-target-type" name="target_type">
      <option value="" <%= !$target_type ? 'selected' : '' %>><%= t('common.any') %></option>
      <option value="post" <%= $target_type && $target_type eq 'post' ? 'selected' : '' %>><%= ui_label('target', 'post') %></option>
      <option value="thread" <%= $target_type && $target_type eq 'thread' ? 'selected' : '' %>><%= ui_label('target', 'thread') %></option>
      <option value="user" <%= $target_type && $target_type eq 'user' ? 'selected' : '' %>><%= ui_label('target', 'user') %></option>
    </select>
    <label for="action-target-id"><%= t('common.target_id') %></label>
    <input id="action-target-id" name="target_id" value="<%= $target_id || '' %>">
    <button type="submit"><%= t('common.filter') %></button>
  </form>

  % if (@{$actions}) {
    <ol class="ui-card-list" aria-label="<%= t('moderation.action_history') %>">
      % for my $action (@{$actions}) {
        <li class="ui-card-list__item">
          <article aria-labelledby="action-<%= $action->{moderation_action_id} %>-heading">
            <h2 id="action-<%= $action->{moderation_action_id} %>-heading">
              <%= ui_label('moderation.action', $action->{action_type}) %>
            </h2>
            <dl>
              <dt><%= t('common.target') %></dt>
              <dd><%= ui_label('target', $action->{target_type}) %>: <%= $action->{target_id} %></dd>
              <dt><%= t('common.reason') %></dt>
              <dd><%= $action->{reason} %></dd>
              <dt><%= t('common.actor') %></dt>
              <dd><%= $action->{actor_user_id} %></dd>
              <dt><%= t('common.created') %></dt>
              <dd><time datetime="<%= $action->{created_at} %>"><%= $action->{created_at} %></time></dd>
              <dt><%= t('moderation.reversed') %></dt>
              <dd>
                % if ($action->{reversed_at}) {
                  <time datetime="<%= $action->{reversed_at} %>"><%= $action->{reversed_at} %></time>
                % } else {
                  <%= t('common.no') %>
                % }
              </dd>
            </dl>
            % if ($action->{target_type} eq 'post' && $action->{action_type} eq 'post.hidden') {
              <form method="post" action="<%= url_for('moderation_post_restore', post_id => $action->{target_id}) %>">
                <%= csrf_field %>
                <label for="action-<%= $action->{moderation_action_id} %>-restore-reason"><%= t('common.reason') %></label>
                <input id="action-<%= $action->{moderation_action_id} %>-restore-reason" name="reason" required>
                <button type="submit"><%= t('moderation.restore_post') %></button>
              </form>
            % }
            % if ($action->{target_type} eq 'thread' && $action->{action_type} eq 'thread.locked') {
              <form method="post" action="<%= url_for('moderation_thread_unlock', thread_id => $action->{target_id}) %>">
                <%= csrf_field %>
                <label for="action-<%= $action->{moderation_action_id} %>-unlock-reason"><%= t('common.reason') %></label>
                <input id="action-<%= $action->{moderation_action_id} %>-unlock-reason" name="reason" required>
                <button type="submit"><%= t('moderation.unlock_thread') %></button>
              </form>
            % }
            % if (!$action->{reversed_at}) {
              <form method="post" action="<%= url_for('moderation_action_reverse', action_id => $action->{moderation_action_id}) %>">
                <%= csrf_field %>
                <label for="action-<%= $action->{moderation_action_id} %>-reverse-reason"><%= t('common.reason') %></label>
                <input id="action-<%= $action->{moderation_action_id} %>-reverse-reason" name="reason" required>
                <button type="submit"><%= t('moderation.reverse_action') %></button>
              </form>
            % }
          </article>
        </li>
      % }
    </ol>
    % if ($next_cursor) {
      <%= include 'components/pagination',
        label => t('moderation.action_history'),
        items => ui_next_page(
          href => url_for('moderation_actions')->query(after => $next_cursor, target_type => $target_type, target_id => $target_id),
          label => t('moderation.next_actions'),
        ) %>
    % }
  % } else {
    <%= include 'components/empty_state',
      heading_id => 'moderation-actions-empty-heading',
      component_title => t('moderation.no_actions_match') %>
  % }
</section>
