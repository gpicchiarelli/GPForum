% layout 'default';
% title t('nav.notifications') . ' - ' . t('app.name');

<section aria-labelledby="notifications-heading">
  <%= include 'components/page_header', heading_id => 'notifications-heading', component_title => t('nav.notifications') %>
  <p><%= tc('notifications.unread_count', $unread_count || 0) %></p>
  % if (@{$notifications}) {
    <ol class="ui-card-list" aria-label="<%= t('notifications.inbox_label') %>">
      % for my $notification (@{$notifications}) {
        % my $presentation = $notification->{presentation} || {};
        <li>
          <article aria-labelledby="notification-<%= $notification->{notification_id} %>-heading">
            <h2 id="notification-<%= $notification->{notification_id} %>-heading">
              <%= $presentation->{title} || t('notifications.title.notification') %>
            </h2>
            % if ($presentation->{summary}) {
              <p><%= $presentation->{summary} %></p>
            % }
            % if ($notification->{payload}{thread_id}) {
              <p>
                <a href="<%= url_for('thread', thread_id => $notification->{payload}{thread_id}) %><%= $notification->{payload}{post_id} ? '#post-' . $notification->{payload}{post_id} : q{} %>">
                  <%= $presentation->{action_label} || t('notifications.open_discussion') %>
                </a>
              </p>
            % }
            <p>
              <%= t('notifications.received_at') %>
              <time datetime="<%= $notification->{created_at} %>"><%= $notification->{created_at} %></time>
            </p>
            % if ($notification->{read_at}) {
              <p role="status"><%= t('notifications.read') %></p>
            % } else {
              <form method="post" action="<%= url_for('notification_read', notification_id => $notification->{notification_id}) %>">
                <%= csrf_field %>
                <button type="submit"><%= t('notifications.mark_read') %></button>
              </form>
            % }
          </article>
        </li>
      % }
    </ol>
  % } else {
    <%= include 'components/empty_state', heading_id => 'notifications-empty-heading', component_title => t('notifications.empty') %>
  % }
  % if ($next_cursor) {
    <%= include 'components/pagination', label => t('notifications.pagination'), items => ui_next_page(href => url_for('notifications')->query(after => $next_cursor), label => t('notifications.older')) %>
  % }
</section>
