msgstr ""
"{variable} deve essere un indirizzo completo, con http:// o https:// e un "
"host, non '{value}'."

#, python-brace-format
msgctxt "database.authentication"
msgid ""
"PostgreSQL at {server} refused the password of role {user}: correct "
"GPFORUM_DATABASE_PASSWORD {where}, or set the role's password with "
"{set_password}."
msgstr ""
"PostgreSQL su {server} ha rifiutato la password del ruolo {user}: correggi "
"GPFORUM_DATABASE_PASSWORD {where}, oppure imposta la password del ruolo con "
"{set_password}."

#, python-brace-format
msgctxt "database.no_hba"
msgid ""
"PostgreSQL at {server} does not let role {user} connect to {database} from "
"this host: allow it in pg_hba.conf, or correct GPFORUM_DATABASE_DSN {where}."
msgstr ""
"PostgreSQL su {server} non consente al ruolo {user} di collegarsi a "
"{database} da questo host: abilitalo in pg_hba.conf, oppure correggi "
"GPFORUM_DATABASE_DSN {where}."

#, python-brace-format
msgctxt "database.not_migrated"
msgid ""
"The database has no {relation} table yet: apply the migrations with "
"{migrate}, or check that GPFORUM_DATABASE_DSN {where} names the forum's "
"database."
msgstr ""
"Il database non ha ancora la tabella {relation}: applica le migrazioni con "
"{migrate}, oppure verifica che GPFORUM_DATABASE_DSN {where} indichi il "
"database del forum."

#, python-brace-format
msgctxt "database.refused"
