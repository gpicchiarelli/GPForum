msgstr ""
"{variable} è lunga {length} caratteri; in {environment} ne servono almeno "
"{minimum}."

#, python-brace-format
msgctxt "config.smtp_host"
msgid "{variable} is required when {transport_variable} is smtp."
msgstr "{variable} è obbligatoria quando {transport_variable} vale smtp."

#, python-brace-format
msgctxt "config.smtp_tls_module"
msgid ""
"{variable}={value} encrypts mail through the Perl module {module}, which "
"this Perl cannot load: install it, or set {variable}=off for a relay that "
"takes mail in the clear."
msgstr ""
"{variable}={value} cifra la posta con il modulo Perl {module}, che questo "
