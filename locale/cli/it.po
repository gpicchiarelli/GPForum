#, python-brace-format
msgctxt "cli.outbox.watching"
msgid ""
"Sending queued mail and events as they come, looking every {seconds} s; "
"Ctrl-C stops."
msgstr ""
"Invio la posta e gli eventi in coda man mano che arrivano, controllando ogni "
"{seconds} s; Ctrl-C per fermare."

#, python-brace-format
msgctxt "cli.partitions.conflict"
msgid ""
"partitions: {partition} cannot be created: {rows} rows already in {default} "
"fall in its range"
msgstr ""
"partizioni: non si può creare {partition}: {rows} righe già in {default} "
"cadono nel suo intervallo"

#, python-brace-format
msgctxt "cli.partitions.conflict_note"
msgid ""
"Run these in psql, in a maintenance window: they lock {table} while they "
"move the rows."
msgstr ""
"Eseguili in psql, in una finestra di manutenzione: bloccano {table} mentre "
"spostano le righe."

#, python-brace-format
msgctxt "cli.partitions.created_many"
msgid "Created {count} monthly partitions; they reach {month}."
msgstr "Create {count} partizioni mensili; arrivano a {month}."

#, python-brace-format
msgctxt "cli.partitions.created_one"
msgid "Created 1 monthly partition; they reach {month}."
msgstr "Creata 1 partizione mensile; arrivano a {month}."

#, python-brace-format
msgctxt "cli.partitions.error"
msgid "partitions: {partition} could not be created: {error}"
msgstr "partizioni: non è stato possibile creare {partition}: {error}"

#, python-brace-format
msgctxt "cli.partitions.in_place"
msgid "The monthly partitions reach {month}."
msgstr "Le partizioni mensili arrivano a {month}."

#, python-brace-format
msgctxt "cli.partitions.planned_many"
msgid "{count} monthly partitions to create, up to {month}."
msgstr "{count} partizioni mensili da creare, fino a {month}."

#, python-brace-format
msgctxt "cli.partitions.planned_one"
msgid "1 monthly partition to create, up to {month}."
msgstr "1 partizione mensile da creare, fino a {month}."

msgctxt "cli.partitions.skipped"
msgid "Another run is creating the partitions now; this one did nothing."
msgstr ""
"Un'altra esecuzione sta creando le partizioni; questa non ha fatto nulla."

msgctxt "cli.restart_service"
msgid "restart GPForum's web service and its outbox worker"
msgstr "riavvia il servizio web di GPForum e il worker dell'outbox"

#, python-brace-format
msgctxt "cli.restore.archive_count"
msgid "{file}: {files} files, where the backup wrote {expected}"
msgstr "{file}: {files} file, dove il backup ne ha scritti {expected}"

#, python-brace-format
msgctxt "cli.restore.archive_ok"
msgid "{file}: {size}, as the backup wrote it; {files} files"
msgstr "{file}: {size}, come l'ha scritto il backup; {files} file"

#, python-brace-format
msgctxt "cli.restore.archive_ok_one"
msgid "{file}: {size}, as the backup wrote it; 1 file"
msgstr "{file}: {size}, come l'ha scritto il backup; 1 file"

#, python-brace-format
msgctxt "cli.restore.archive_unreadable"
msgid "{file}: tar cannot read it ({reason})"
msgstr "{file}: tar non riesce a leggerlo ({reason})"

#, python-brace-format
msgctxt "cli.restore.bad_manifest"
msgid "manifest: {directory}/manifest.json is not a GPForum backup's manifest"
msgstr ""
"manifest: {directory}/manifest.json non è il manifest di un backup di GPForum"

#, python-brace-format
msgctxt "cli.restore.cannot_read"
msgid ""
"manifest: {user} cannot read {path}: check the backup as its owner, "
"{owner}, with {command}"
msgstr ""
"manifest: {user} non può leggere {path}: verifica il backup come il suo "
"proprietario, {owner}, con {command}"

#, python-brace-format
msgctxt "cli.restore.checksum_differs"
msgid ""
"{file}: its SHA-256 is not the one the backup wrote: it changed after the "
"backup"
msgstr ""
"{file}: il suo SHA-256 non è quello scritto dal backup: è cambiato dopo il "
"backup"

#, python-brace-format
msgctxt "cli.restore.dump_ok"
msgid ""
"{file}: {size}, as the backup wrote it; pg_restore reads its {entries} "
"entries"
msgstr ""
"{file}: {size}, come l'ha scritto il backup; pg_restore ne legge le "
"{entries} voci"

#, python-brace-format
msgctxt "cli.restore.dump_unreadable"
msgid "{file}: pg_restore cannot read it ({reason})"
msgstr "{file}: pg_restore non riesce a leggerlo ({reason})"

#, python-brace-format
msgctxt "cli.restore.file_cannot_read"
msgid ""
"{file}: {user} cannot read it: check the backup as its owner, {owner}, "
"with {command}"
msgstr ""
"{file}: {user} non può leggerlo: verifica il backup come il suo "
"proprietario, {owner}, con {command}"

#, python-brace-format
msgctxt "cli.restore.file_ok"
msgid "{file}: {size}, as the backup wrote it"
msgstr "{file}: {size}, come l'ha scritto il backup"

#, python-brace-format
msgctxt "cli.restore.holds_backups"
msgid "manifest: {directory} holds backups, and is not one itself"
msgstr "manifest: {directory} contiene dei backup, ma non è un backup"

#, python-brace-format
msgctxt "cli.restore.manifest"
msgid "manifest: {database}, taken {taken}, schema {schema}"
msgstr "manifest: {database}, fatto il {taken}, schema {schema}"

#, python-brace-format
msgctxt "cli.restore.missing"
msgid "{file}: not in the backup"
msgstr "{file}: non è nel backup"

#, python-brace-format
msgctxt "cli.restore.needs_check"
msgid ""
"gpforum restore checks a backup and restores nothing: gpforum restore "
"--check DIR. Restoring one is done by hand, with the steps in {guide}."
msgstr ""
"gpforum restore verifica un backup e non ripristina nulla: gpforum restore "
"--check DIR. Un ripristino si fa a mano, con i passi di {guide}."

#, python-brace-format
msgctxt "cli.restore.newer_manifest"
msgid "manifest: {directory} was written by a newer GPForum than this one"
msgstr ""
"manifest: {directory} è stato scritto da un GPForum più recente di questo"

msgctxt "cli.restore.next_backup"
msgid "keep it as it is, and take another with gpforum backup"
msgstr "conservalo così com'è, e fanne un altro con gpforum backup"

#, python-brace-format
msgctxt "cli.restore.next_latest"
msgid "check its newest backup, with {command}"
msgstr "verifica il suo backup più recente, con {command}"

#, python-brace-format
msgctxt "cli.restore.next_restore"
msgid "to restore it, follow the steps in {guide}"
msgstr "per ripristinarlo, segui i passi di {guide}"

msgctxt "cli.restore.no_attachments"
msgid ""
"attachments: none; the attachment root did not exist when the backup was "
"taken"
msgstr ""
"allegati: nessuno; la directory degli allegati non esisteva quando è stato "
"fatto il backup"

#, python-brace-format
msgctxt "cli.restore.no_directory"
msgid "manifest: there is no {directory}"
msgstr "manifest: {directory} non esiste"

#, python-brace-format
msgctxt "cli.restore.no_manifest"
msgid ""
"manifest: {directory} has no manifest.json, so it is not a GPForum backup"
msgstr ""
"manifest: {directory} non ha un manifest.json, quindi non è un backup di "
"GPForum"

#, python-brace-format
msgctxt "cli.restore.no_pg_restore"
msgid ""
"{file}: cannot be read without PostgreSQL's pg_restore: install its client "
"programs, or name it with GPFORUM_PG_RESTORE"
msgstr ""
"{file}: non si può leggere senza pg_restore di PostgreSQL: installa i suoi "
"programmi client, o indicalo con GPFORUM_PG_RESTORE"

#, python-brace-format
msgctxt "cli.restore.not_listed"
msgid "{file}: the manifest does not list it, so the backup is not whole"
msgstr "{file}: il manifest non lo elenca, quindi il backup non è completo"

#, python-brace-format
msgctxt "cli.restore.size_differs"
msgid ""
"{file}: {size}, where the backup wrote {expected}: it was cut short or "
"changed"
msgstr ""
"{file}: {size}, dove il backup ne ha scritti {expected}: è stato troncato o "
"modificato"

msgctxt "cli.restore.sound"
msgid "The backup can be restored; nothing was restored."
msgstr "Il backup si può ripristinare; non è stato ripristinato nulla."

msgctxt "cli.restore.unsound"
msgid "This backup cannot be restored as it is."
msgstr "Questo backup non si può ripristinare così com'è."

#, python-brace-format
msgctxt "cli.secret.metrics.finished"
msgid ""
"The previous metrics tokens are gone from {file}; a scraper that sends one "
"is refused."
msgstr ""
"I token delle metriche precedenti non sono più in {file}; uno scraper che ne "
"invia uno viene rifiutato."

#, python-brace-format
msgctxt "cli.secret.metrics.finished_live"
msgid ""
"The previous metrics tokens are gone from {file}, and the running service "
"refuses them now, with no restart."
msgstr ""
"I token delle metriche precedenti non sono più in {file}, e il servizio in "
"esecuzione li rifiuta già, senza riavvio."

#, python-brace-format
msgctxt "cli.secret.metrics.first"
msgid "A new metrics token is in {file}."
msgstr "Un nuovo token delle metriche è in {file}."

#, python-brace-format
msgctxt "cli.secret.metrics.first_live"
msgid ""
"A new metrics token is in {file}, and the running service asks for it now, "
"with no restart."
msgstr ""
"Un nuovo token delle metriche è in {file}, e il servizio in esecuzione lo "
"chiede già, senza riavvio."

#, python-brace-format
msgctxt "cli.secret.metrics.next_scrapers"
msgid "give every scraper the new {variable} from {file}"
msgstr "dai a ogni scraper il nuovo {variable} da {file}"

#, python-brace-format
msgctxt "cli.secret.metrics.rotated"
msgid ""
"A new metrics token is in {file}. The one before stays in {list}, so no "
"scraper is refused."
msgstr ""
"Un nuovo token delle metriche è in {file}. Quello precedente resta in "
"{list}, così nessuno scraper viene rifiutato."

#, python-brace-format
msgctxt "cli.secret.metrics.rotated_live"
msgid ""
"A new metrics token is in {file}. The one before stays in {list}, and the "
"running service accepts both now, with no restart."
msgstr ""
"Un nuovo token delle metriche è in {file}. Quello precedente resta in "
"{list}, e il servizio in esecuzione li accetta già entrambi, senza riavvio."

#, python-brace-format
msgctxt "cli.secret.metrics.then"
msgid ""
"give every scraper the new {variable} from {file}, then gpforum secret "
"rotate metrics --finish"
msgstr ""
"dai a ogni scraper il nuovo {variable} da {file}, poi gpforum secret rotate "
"metrics --finish"

#, python-brace-format
msgctxt "cli.secret.metrics.would_finished"
msgid ""
"Would drop the previous metrics tokens from {file}; nothing was written."
msgstr ""
"Toglierebbe i token delle metriche precedenti da {file}; non è stato scritto "
"nulla."

#, python-brace-format
msgctxt "cli.secret.metrics.would_first"
msgid "Would write a new metrics token to {file}; nothing was written."
msgstr ""
"Scriverebbe un nuovo token delle metriche in {file}; non è stato scritto "
"nulla."

#, python-brace-format
msgctxt "cli.secret.metrics.would_rotated"
msgid ""
"Would write a new metrics token to {file} and keep the one before in {list}; "
"nothing was written."
msgstr ""
"Scriverebbe un nuovo token delle metriche in {file} e terrebbe quello "
"precedente in {list}; non è stato scritto nulla."

msgctxt "cli.secret.needs_kind"
msgid "Say which secret to rotate: session or metrics."
msgstr "Indica quale segreto ruotare: session o metrics."

msgctxt "cli.secret.needs_rotate"
msgid "gpforum secret rotates: gpforum secret rotate session, or metrics."
msgstr ""
"gpforum secret ruota i segreti: gpforum secret rotate session, oppure "
"metrics."

#, python-brace-format
msgctxt "cli.secret.no_file"
msgid ""
"There is no environment file to write to: make {file} from "
"deploy/gpforum.env.example, or name one with gpforum --env-file FILE secret "
"rotate {kind}."
msgstr ""
"Non c'è un file d'ambiente su cui scrivere: crea {file} da "
"deploy/gpforum.env.example, oppure indicane uno con gpforum --env-file FILE "
"secret rotate {kind}."

#, python-brace-format
msgctxt "cli.secret.nothing_to_finish"
msgid "{file} lists no previous one in {list}: there is nothing to finish."
msgstr "{file} non elenca precedenti in {list}: non c'è nulla da concludere."

#, python-brace-format
msgctxt "cli.secret.session.finished"
msgid ""
"The previous session secrets are gone from {file}; a cookie they signed no "
"longer signs anyone in."
msgstr ""
"I segreti di sessione precedenti non sono più in {file}; un cookie firmato "
"con essi non dà più accesso."

#, python-brace-format
msgctxt "cli.secret.session.first"
msgid "A new session secret is in {file}."
msgstr "Un nuovo segreto di sessione è in {file}."

#, python-brace-format
msgctxt "cli.secret.session.rotated"
msgid ""
"A new session secret is in {file}. The one before stays in {list}, so nobody "
"is signed out."
msgstr ""
"Un nuovo segreto di sessione è in {file}. Quello precedente resta in {list}, "
"così nessuno perde l'accesso."

#, python-brace-format
msgctxt "cli.secret.session.then"
msgid ""
"in {days} days, when every session has been renewed, gpforum secret rotate "
"session --finish"
msgstr ""
"tra {days} giorni, quando ogni sessione sarà stata rinnovata, gpforum secret "
"rotate session --finish"

#, python-brace-format
msgctxt "cli.secret.session.would_finished"
msgid ""
"Would drop the previous session secrets from {file}; nothing was written."
msgstr ""
"Toglierebbe i segreti di sessione precedenti da {file}; non è stato scritto "
"nulla."

#, python-brace-format
msgctxt "cli.secret.session.would_first"
msgid "Would write a new session secret to {file}; nothing was written."
msgstr ""
"Scriverebbe un nuovo segreto di sessione in {file}; non è stato scritto "
"nulla."

#, python-brace-format
msgctxt "cli.secret.session.would_rotated"
msgid ""
"Would write a new session secret to {file} and keep the one before in "
"{list}; nothing was written."
msgstr ""
"Scriverebbe un nuovo segreto di sessione in {file} e terrebbe quello "
"precedente in {list}; non è stato scritto nulla."

#, python-brace-format
msgctxt "cli.secret.unknown_kind"
msgid "'{kind}' is not a secret gpforum rotates: session or metrics."
msgstr "'{kind}' non è un segreto che gpforum ruota: session o metrics."

#, python-brace-format
msgctxt "cli.secret.unwritable"
msgid "Cannot write {file} ({reason}): run it as root: {command}"
msgstr ""
"Impossibile scrivere {file} ({reason}): eseguilo come root: "
"{command}"

#, python-brace-format
msgctxt "cli.secret.world_readable"
msgid ""
"Every account on this host can read {file}, secrets included: "
"{command}"
msgstr ""
"Ogni account di questo host può leggere {file}, segreti compresi: "
"{command}"

msgctxt "cli.service.caddy_whole"
msgid ""
"The Caddyfile is the whole of Caddy's configuration: if Caddy serves other "
"sites too, add this block to yours instead."
msgstr ""
"Il Caddyfile è l'intera configurazione di Caddy: se Caddy serve anche altri "
"siti, aggiungi invece questo blocco al tuo."

#, python-brace-format
msgctxt "cli.service.cannot_write"
msgid "Cannot write the files into {directory} ({reason})."
msgstr "Impossibile scrivere i file in {directory} ({reason})."

#, python-brace-format
msgctxt "cli.service.certificate"
msgid ""
"The site names its certificate under /etc/letsencrypt/live/{host}/: correct "
"the two ssl_certificate lines if yours is elsewhere."
msgstr ""
"Il sito cerca il suo certificato in /etc/letsencrypt/live/{host}/: correggi "
"le due righe ssl_certificate se il tuo è altrove."

#, python-brace-format
msgctxt "cli.service.foreign_files"
msgid ""
"{directory} holds files that are not {target}'s ({files}), which copying its "
"contents would install too: name an empty directory, or a new one."
msgstr ""
"{directory} contiene file che non sono di {target} ({files}), che copiandone "
"il contenuto verrebbero installati anch'essi: indica una directory vuota, o "
"una nuova."

msgctxt "cli.service.needs_print"
msgid ""
"Say what to print: gpforum service print, or gpforum service print nginx."
msgstr ""
"Indica cosa stampare: gpforum service print, oppure gpforum service print "
"nginx."

msgctxt "cli.service.next_in_place_many"
msgid "start them:"
msgstr "avviali:"

msgctxt "cli.service.next_in_place_one"
msgid "make it take effect:"
msgstr "rendilo effettivo:"

msgctxt "cli.service.next_many"
msgid "put them in place and start them:"
msgstr "mettili al loro posto e avviali:"

msgctxt "cli.service.next_one"
msgid "put it in place:"
msgstr "mettilo al suo posto:"

msgctxt "cli.service.next_read_many"
msgid "read them, then put them in place and start them:"
msgstr "leggili, poi mettili al loro posto e avviali:"

msgctxt "cli.service.next_read_one"
msgid "read it, then put it in place:"
msgstr "leggilo, poi mettilo al suo posto:"

msgctxt "cli.service.nginx_include"
msgid ""
"nginx reads it once the http block of /usr/local/etc/nginx/nginx.conf has "
"the line include conf.d/*.conf;"
msgstr ""
"nginx lo legge quando il blocco http di /usr/local/etc/nginx/nginx.conf "
"contiene la riga include conf.d/*.conf;"

#, python-brace-format
msgctxt "cli.service.no_certificate"
msgid ""
"There is no {certificate} yet, and nginx refuses a site without its "
"certificate: take it first, with {command}, then print the site again."
msgstr ""
"{certificate} non c'è ancora, e nginx rifiuta un sito senza il suo "
"certificato: prendilo prima, con {command}, poi stampa di nuovo il sito."

#, python-brace-format
msgctxt "cli.service.no_target"
msgid ""
"This host has no service manager GPForum ships files for: name one, "
"{targets}."
msgstr ""
"Questo host non ha un gestore dei servizi per cui GPForum fornisca file: "
"indicane uno, {targets}."

#, python-brace-format
msgctxt "cli.service.not_directory"
msgid ""
"{directory} is a file, not a directory: name a directory to write the files "
"into."
msgstr ""
"{directory} è un file, non una directory: indica una directory in cui "
"scrivere i file."

#, python-brace-format
msgctxt "cli.service.not_files"
msgid ""
"{directory} holds {files} as links or directories, not files, and writing "
"there would follow them: name an empty directory, or a new one."
msgstr ""
"{directory} contiene {files} come link o directory, non come file, e "
"scrivere lì li seguirebbe: indica una directory vuota, o una nuova."

#, python-brace-format
msgctxt "cli.service.open_directory"
msgid ""
"{directory} can be changed by another account, which could change the files "
"before you copy them into place: name a directory of your own."
msgstr ""
"{directory} può essere modificata da un altro account, che potrebbe cambiare "
"i file prima che tu li copi al loro posto: indica una directory tua."

#, python-brace-format
msgctxt "cli.service.placeholder_host"
msgid ""
"GPFORUM_PUBLIC_BASE_URL is {url}, not the address members reach the forum "
"at, so the site is written for {host}: set {variable} {where}, then print it "
"again."
msgstr ""
"GPFORUM_PUBLIC_BASE_URL è {url}, non l'indirizzo a cui i membri raggiungono "
"il forum, quindi il sito è scritto per {host}: imposta {variable} {where}, "
"poi stampalo di nuovo."

#, python-brace-format
msgctxt "cli.service.unknown_file"
msgid ""
"'{name}' is not one of {target}'s files ({names}), nor something gpforum "
"service prints ({targets})."
msgstr ""
"'{name}' non è uno dei file di {target} ({names}), né qualcosa che gpforum "
"service stampa ({targets})."

#, python-brace-format
msgctxt "cli.service.wrote_many"
msgid "{count} files for {target} are in {directory}: {files}."
msgstr "{count} file per {target} sono in {directory}: {files}."

#, python-brace-format
msgctxt "cli.service.wrote_one"
msgid "{files} for {target} is in {directory}."
msgstr "{files} per {target} è in {directory}."

#, python-brace-format
msgctxt "cli.start.busy"
msgid ""
"Something else listens on {listen} ({reason}): stop it, or listen on "
"another port: {other}"
msgstr ""
"Qualcos'altro è in ascolto su {listen} ({reason}): fermalo, oppure "
"ascolta su un'altra porta: {other}"

#, python-brace-format
msgctxt "cli.start.cannot_listen"
msgid ""
"Cannot listen on {listen} ({reason}): listen on an address this host has: "
"{other}"
msgstr ""
"Impossibile mettersi in ascolto su {listen} ({reason}): usa un indirizzo "
"che questo host ha: {other}"

#, python-brace-format
msgctxt "cli.start.foreground"
msgid ""
"gpforum start runs the forum in this terminal, for development, with "
"--foreground. A server runs it under its service manager: {start}"
msgstr ""
"gpforum start avvia il forum in questo terminale, per lo sviluppo, con "
"--foreground. Un server lo esegue sotto il suo gestore dei servizi: {start}"

#, python-brace-format
msgctxt "cli.start.no_hypnotoad"
msgid ""
"There is no {file}, so the dependencies are not installed: sudo bin/gpforum "
"setup installs them."
msgstr ""
"Non c'è {file}, quindi le dipendenze non sono installate: le installa sudo "
"bin/gpforum setup."

msgctxt "cli.start_service"
msgid "start GPForum's web service and its outbox worker"
msgstr "avvia il servizio web di GPForum e il worker dell'outbox"

#, python-brace-format
msgctxt "cli.then"
msgid "Then: {step}"
msgstr "Poi: {step}"

#, python-brace-format
msgctxt "cli.upgrade.backup"
msgid "Before them, a backup to come back to: {command}"
msgstr "Prima, un backup a cui tornare: {command}"

msgctxt "cli.upgrade.complete"
msgid ""
"The last one ends with \"Nothing to fix.\" when the upgrade is complete."
msgstr ""
"L'ultimo finisce con \"Niente da sistemare.\" quando l'aggiornamento è "
"completo."

msgctxt "cli.upgrade.guide"
msgid ""
"docs/ops/upgrade.md says what each one does, and the CHANGELOG what a "
"release asks besides, under \"Operator action required\"."
msgstr ""
"docs/ops/upgrade.md spiega cosa fa ciascuno, e il CHANGELOG cosa chiede in "
"più una versione, sotto \"Operator action required\"."

#, python-brace-format
msgctxt "cli.upgrade.restart"
msgid "After gpforum migrate, {step}."
msgstr "Dopo gpforum migrate, {step}."

msgctxt "cli.upgrade.restart_foreground"
msgid "restart the forum you run with gpforum start --foreground"
msgstr "riavvia il forum che esegui con gpforum start --foreground"

msgctxt "cli.upgrade.title"
msgid "Upgrade this forum with these three commands, in order:"
msgstr "Aggiorna questo forum con questi tre comandi, in ordine:"

msgctxt "cli.verb.admin"
msgid "Create the forum's owner, or make a member one"
msgstr "Crea il proprietario del forum, o rendi tale un membro"

msgctxt "cli.verb.antivirus_check"
msgid "Check that uploads are scanned"
msgstr "Verifica che i file caricati vengano analizzati"

msgctxt "cli.verb.backup"
msgid "Back up the database and the uploads"
msgstr "Fai il backup del database e dei file caricati"

msgctxt "cli.verb.benchmark"
msgid "Benchmark the pages a member reads most"
msgstr "Misura le pagine che i membri leggono di più"

msgctxt "cli.verb.budgets"
msgid "Check or sync the query budgets"
msgstr "Verifica o allinea i budget di query"

msgctxt "cli.verb.dead_letter_check"
msgid "Rehearse the dead-letter path, in memory"
msgstr "Prova il percorso delle dead letter, in memoria"

msgctxt "cli.verb.dead_letters"
msgid "Review and replay messages that kept failing"
msgstr "Esamina e rimanda i messaggi che continuavano a fallire"

msgctxt "cli.verb.doctor"
msgid "Check the forum, from its settings to its address, with what to fix"
msgstr ""
"Controlla il forum, dalle impostazioni all'indirizzo, con cosa sistemare"

msgctxt "cli.verb.evidence_meta"
msgid "Stamp an evidence file"
msgstr "Marca un file di evidenze"

msgctxt "cli.verb.evidence_validate"
msgid "Validate an evidence bundle"
msgstr "Valida un pacchetto di evidenze"

msgctxt "cli.verb.hypnotoad_benchmark"
msgid "Benchmark Hypnotoad, optionally behind a proxy"
msgstr "Misura Hypnotoad, anche dietro un proxy"

msgctxt "cli.verb.hypnotoad_scaling"
msgid "Benchmark Hypnotoad across worker counts"
msgstr "Misura Hypnotoad al variare dei worker"

msgctxt "cli.verb.mail_check"
msgid "Check that mail can leave this host"
msgstr "Verifica che la posta possa uscire da questo host"

msgctxt "cli.verb.mail_lifecycle_check"
msgid "Rehearse mail's lifecycle, end to end"
msgstr "Prova il ciclo di vita della posta, da capo a fondo"

msgctxt "cli.verb.migrate"
msgid "Bring the database up to date"
msgstr "Aggiorna il database"

msgctxt "cli.verb.os_preflight"
msgid "Check the host's limits against the processes it runs"
msgstr "Confronta i limiti dell'host con i processi che esegue"

msgctxt "cli.verb.outbox"
msgid "Send the queued mail and events"
msgstr "Invia la posta e gli eventi in coda"

msgctxt "cli.verb.partitions"
msgid "Create the next monthly log partitions"
msgstr "Crea le prossime partizioni mensili dei log"

msgctxt "cli.verb.performance_seed"
msgid "Seed data for performance work"
msgstr "Genera dati per il lavoro sulle prestazioni"

msgctxt "cli.verb.platform_check"
msgid "Check that this host can run GPForum"
msgstr "Verifica che questo host possa eseguire GPForum"

msgctxt "cli.verb.query_plan_evidence"
msgid "Collect EXPLAIN evidence for the budgeted pages"
msgstr "Raccogli le evidenze EXPLAIN per le pagine con budget"

msgctxt "cli.verb.restore"
msgid "Check that a backup can be restored"
msgstr "Verifica che un backup si possa ripristinare"

msgctxt "cli.verb.scheduled_jobs"
msgid "Run the retention and clean-up jobs once"
msgstr "Esegui una volta i lavori di conservazione e pulizia"

msgctxt "cli.verb.search_rebuild"
msgid "Rebuild the search index, or report its lag"
msgstr "Ricostruisci l'indice di ricerca, o mostrane il ritardo"

msgctxt "cli.verb.secret"
msgid "Rotate the session secret or the metrics token"
msgstr "Ruota il segreto di sessione o il token delle metriche"

msgctxt "cli.verb.service"
msgid "Print the service files, written for this host"
msgstr "Stampa i file dei servizi, scritti per questo host"

msgctxt "cli.verb.setup"
msgid "Set this host up: the settings, the database, the schema"
msgstr "Prepara questo host: le impostazioni, il database, lo schema"

msgctxt "cli.verb.staging_drill"
msgid "Rehearse a backup and restore"
msgstr "Prova un backup e un ripristino"

msgctxt "cli.verb.staging_drill_attachments"
msgid "Rehearse the attachment store, end to end"
msgstr "Prova l'archivio degli allegati, da capo a fondo"

msgctxt "cli.verb.staging_host_verify"
msgid "Verify a host against the deploy files"
msgstr "Verifica un host rispetto ai file di deploy"

msgctxt "cli.verb.start"
msgid "Run the forum in this terminal, for development"
msgstr "Avvia il forum in questo terminale, per lo sviluppo"

msgctxt "cli.verb.status"
msgid "Show the running forum's readiness report"
msgstr "Mostra il rapporto di prontezza del forum in esecuzione"

msgctxt "cli.verb.stress_load"
msgid "Put a running forum under load"
msgstr "Metti sotto carico un forum in esecuzione"

msgctxt "cli.verb.upgrade"
msgid "Print the commands that upgrade this forum"
msgstr "Stampa i comandi che aggiornano questo forum"

#, python-brace-format
msgctxt "config.antivirus_command"
msgid "{variable} is required when {antivirus_variable} is command."
msgstr "{variable} è obbligatoria quando {antivirus_variable} vale command."

#, python-brace-format
