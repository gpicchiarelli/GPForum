msgctxt "cli.jobs.reason.scanning_off"
msgid "scanning is off"
msgstr "la scansione è spenta"

msgctxt "cli.jobs.reason.unavailable"
msgid "not available here"
msgstr "non disponibile qui"

#, python-brace-format
msgctxt "cli.jobs.removed_many"
msgid "{job}: {count} removed"
msgstr "{job}: {count} elementi rimossi"

#, python-brace-format
msgctxt "cli.jobs.removed_one"
msgid "{job}: 1 removed"
msgstr "{job}: 1 elemento rimosso"

#, python-brace-format
msgctxt "cli.jobs.scanned_many"
msgid "{job}: {count} scanned"
msgstr "{job}: {count} scansionati"

#, python-brace-format
msgctxt "cli.jobs.scanned_one"
