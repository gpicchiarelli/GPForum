#, python-brace-format
msgctxt "cli.outbox.dead_many"
msgid "{count} given up on"
msgstr "{count} abbandonati"

msgctxt "cli.outbox.dead_one"
msgid "1 given up on"
msgstr "1 abbandonato"

#, python-brace-format
msgctxt "cli.outbox.lost_many"
