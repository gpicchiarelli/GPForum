msgctxt "config.development_secret"
msgid "{variable} must not include the development default."
msgstr "{variable} non deve contenere il valore di sviluppo."

#, python-brace-format
msgctxt "config.did_you_mean"
msgid "Did you mean {suggestion}?"
msgstr "Forse intendevi {suggestion}?"

#, python-brace-format
msgctxt "config.example"
msgid "Example: {assignment}"
msgstr "Esempio: {assignment}"

msgctxt "config.footer"
msgid ""
"Set these in the service's environment file (deploy/gpforum.env.example "
"describes every setting), then try again."
msgstr ""
"Impostale nel file d'ambiente del servizio (deploy/gpforum.env.example "
"descrive ogni impostazione), poi riprova."

#, python-brace-format
msgctxt "config.generate"
msgid "Generate one with: {command}"
msgstr "Generane uno con: {command}"

#, python-brace-format
msgctxt "config.glifistore_url"
msgid ""
"{variable} must be tcp://host:port, unix://path or host:port, not "
"'{value}'."
msgstr ""
"{variable} deve essere tcp://host:porta, unix://percorso oppure "
"host:porta, non '{value}'."

msgctxt "config.header"
msgid "GPForum's settings need attention:"
msgstr "Le impostazioni di GPForum vanno sistemate:"

#, python-brace-format
msgctxt "config.https"
msgid "{variable} must use https:// in {environment}, not '{value}'."
msgstr "{variable} deve usare https:// in {environment}, non '{value}'."

#, python-brace-format
msgctxt "config.listen"
msgid ""
"{variable} must list addresses such as http://127.0.0.1:8080, not "
"'{value}'."
msgstr ""
"{variable} deve elencare indirizzi come http://127.0.0.1:8080, non "
"'{value}'."

#, python-brace-format
msgctxt "config.log_transport"
msgid ""
"{variable}=log only writes mail to the log; {environment} must deliver it, "
"with sendmail or smtp."
msgstr ""
"{variable}=log scrive la posta solo nel log; in {environment} va "
"consegnata, con sendmail o smtp."

#, python-brace-format
msgctxt "config.mail_from_local"
msgid ""
"{variable} is '{value}': mail servers refuse a sender at localhost, so "
"{environment} needs an address at the forum's own domain."
msgstr ""
"{variable} vale '{value}': i server di posta rifiutano un mittente su "
"localhost, quindi in {environment} serve un indirizzo del dominio del "
"forum."

#, python-brace-format
msgctxt "config.minion_url"
msgid "{variable} is required while {minion_variable} is on."
msgstr "{variable} è obbligatoria quando {minion_variable} è attivo."

#, python-brace-format
msgctxt "config.not_above"
msgid "{variable} must not exceed {limit_variable} ({limit}), not {value}."
msgstr "{variable} non può superare {limit_variable} ({limit}), non {value}."

#, python-brace-format
msgctxt "config.not_boolean"
msgid "{variable} must be on or off, not '{value}'."
msgstr "{variable} deve essere on oppure off, non '{value}'."

#, python-brace-format
msgctxt "config.not_integer"
msgid "{variable} must be a whole number, not '{value}'."
msgstr "{variable} deve essere un numero intero, non '{value}'."

#, python-brace-format
msgctxt "config.not_integer_or_auto"
msgid "{variable} must be a whole number or auto, not '{value}'."
msgstr "{variable} deve essere un numero intero oppure auto, non '{value}'."

#, python-brace-format
msgctxt "config.one_of"
msgid "{variable} must be one of {choices}, not '{value}'."
msgstr "{variable} deve essere uno tra {choices}, non '{value}'."

#, python-brace-format
msgctxt "config.placeholder_mail_from"
msgid ""
"{variable} is '{value}', an example address mail servers will not deliver "
"from; {environment} needs one at the forum's own domain."
msgstr ""
"{variable} vale '{value}', un indirizzo d'esempio da cui i server di posta "
"non consegnano; in {environment} ne serve uno del dominio del forum."

#, python-brace-format
msgctxt "config.placeholder_url"
msgid ""
"{variable} is '{value}', an example address that leads nowhere; "
"{environment} needs the one members reach this forum at."
msgstr ""
"{variable} vale '{value}', un indirizzo d'esempio che non porta da nessuna "
"parte; in {environment} serve quello a cui i membri raggiungono questo forum."

#, python-brace-format
msgctxt "config.renamed"
msgid ""
"{variable} is now called {replacement}; write {assignment} in the "
"environment file in its place."
msgstr ""
"{variable} ora si chiama {replacement}; scrivi {assignment} nel file "
"d'ambiente al suo posto."

#, python-brace-format
msgctxt "config.renamed_value"
msgid ""
"{variable}={old} is now called {value}; write {assignment} in the "
"environment file in its place."
msgstr ""
"{variable}={old} ora si chiama {value}; scrivi {assignment} nel file "
"d'ambiente al suo posto."

#, python-brace-format
msgctxt "config.required"
msgid "{variable} is required."
msgstr "{variable} è obbligatoria."

#, python-brace-format
msgctxt "config.required_in"
msgid "{variable} is required in {environment}."
msgstr "{variable} è obbligatoria in {environment}."

#, python-brace-format
msgctxt "config.retired"
msgid ""
"{variable} no longer has any effect; remove it from the environment file."
msgstr "{variable} non ha più alcun effetto; toglila dal file d'ambiente."

#, python-brace-format
msgctxt "config.short_secret"
msgid ""
"{variable} is {length} characters long; {environment} needs at least "
