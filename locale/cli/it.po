# GPForum command-line messages, Italian.
# SPDX-FileCopyrightText: 2026 Giacomo Picchiarelli
# SPDX-License-Identifier: BSD-3-Clause
#
# What GPForum says to an operator at the command line, at start-up and in
# the log; the forum's own pages read locale/*.po. Each message's msgctxt is
# the key the code asks for and its msgid is the English text; msgstr is what
# an operator whose LC_ALL, LC_MESSAGES or LANG names this language reads.
# {name} placeholders are filled in by GPForum::Config::Report. The English
# of the config.* keys is also in that module, and t/462 keeps them equal.
msgid ""
msgstr ""
"Project-Id-Version: GPForum\n"
"PO-Revision-Date: 2026-10-08 00:00+0000\n"
"Last-Translator: Giacomo Picchiarelli\n"
"Language-Team: Italian\n"
"Language: it\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgctxt "antivirus.broken"
msgid "antivirus: it does not scan uploads as it should"
msgstr "antivirus: non analizza gli upload come dovrebbe"

#, python-brace-format
msgctxt "antivirus.detail"
msgid "Detail: {detail}"
msgstr "Dettaglio: {detail}"

#, python-brace-format
msgctxt "antivirus.fix_clamd"
msgid "then set GPFORUM_ANTIVIRUS=clamd {where}"
msgstr "poi imposta GPFORUM_ANTIVIRUS=clamd {where}"

#, python-brace-format
msgctxt "antivirus.fix_none"
msgid ""
"or set GPFORUM_ANTIVIRUS=none {where}, and uploads are checked for format "
"only"
msgstr ""
"oppure imposta GPFORUM_ANTIVIRUS=none {where}, e degli upload si controlla "
"solo il formato"

#, python-brace-format
msgctxt "antivirus.fix_signatures"
msgid "update the signatures: {command}"
msgstr "aggiorna le firme: {command}"

#, python-brace-format
msgctxt "antivirus.fix_start"
msgid ""
"or, if it is installed, start it: {command} (clamd waits for freshclam's "
"first download)"
msgstr ""
"oppure, se è installato, avvialo: {command} (clamd aspetta il primo "
"download di freshclam)"

msgctxt "antivirus.off"
msgid "antivirus: off; uploads are checked for format only"
msgstr "antivirus: spento; degli upload si controlla solo il formato"

#, python-brace-format
msgctxt "antivirus.unreachable"
msgid "antivirus: clamd does not answer at {socket}"
msgstr "antivirus: clamd non risponde su {socket}"

#, python-brace-format
msgctxt "antivirus.works"
msgid ""
"antivirus: {engine} finds the test file and lets an ordinary one through"
msgstr ""
"antivirus: {engine} trova il file di prova e lascia passare un file normale"

#, python-brace-format
msgctxt "cli.admin.already_owner"
msgid "{username} ({email}) was the forum's owner already; nothing changed."
msgstr ""
"{username} ({email}) era già il proprietario del forum; non è cambiato nulla."

#, python-brace-format
msgctxt "cli.admin.already_owner_id"
msgid "User {user} held the {role} role already; nothing changed."
msgstr "L'utente {user} aveva già il ruolo {role}; non è cambiato nulla."

#, python-brace-format
msgctxt "cli.admin.created"
msgid "{username} ({email}) is the forum's owner and can sign in now."
msgstr ""
"{username} ({email}) è il proprietario del forum e può accedere subito."

msgctxt "cli.admin.display_name"
msgid "The display name cannot be empty."
msgstr "Il nome visualizzato non può essere vuoto."

#, python-brace-format
msgctxt "cli.admin.email_format"
msgid "'{value}' is not an email address."
msgstr "'{value}' non è un indirizzo email."

#, python-brace-format
msgctxt "cli.admin.email_taken"
msgid ""
"There is already an account with {email}: make it the owner with gpforum "
"admin grant {email}."
msgstr ""
"Esiste già un account con {email}: rendilo proprietario con gpforum admin "
"grant {email}."

#, python-brace-format
msgctxt "cli.admin.granted"
msgid "{username} ({email}) is the forum's owner."
msgstr "{username} ({email}) è il proprietario del forum."

#, python-brace-format
msgctxt "cli.admin.granted_id"
msgid "User {user} holds the {role} role."
msgstr "L'utente {user} ha il ruolo {role}."

msgctxt "cli.admin.member_or_id"
msgid "Name the member by address, username or --user-id: one of them."
msgstr "Indica il membro per indirizzo, nome utente o --user-id: uno solo."

msgctxt "cli.admin.needs_action"
msgid "Say what to do: gpforum admin create, or gpforum admin grant."
msgstr "Di' cosa fare: gpforum admin create, oppure gpforum admin grant."

msgctxt "cli.admin.needs_member"
msgid "Say whom to make the owner: their email address or username."
msgstr ""
"Indica chi rendere proprietario: il suo indirizzo email o il nome utente."

#, python-brace-format
msgctxt "cli.admin.needs_option"
msgid "gpforum admin create needs {option}."
msgstr "gpforum admin create richiede {option}."

#, python-brace-format
msgctxt "cli.admin.next_sign_in"
msgid "sign in at {url}"
msgstr "accedi da {url}"

#, python-brace-format
msgctxt "cli.admin.no_member"
msgid ""
"No account has the address or username '{member}': make one with gpforum "
"admin create."
msgstr ""
"Nessun account ha l'indirizzo o il nome utente '{member}': creane uno con "
"gpforum admin create."

msgctxt "cli.admin.no_password"
msgid "Standard input held no password; nothing was created."
msgstr ""
"Lo standard input non conteneva una password; non è stato creato nulla."

msgctxt "cli.admin.no_terminal"
msgid ""
"There is no terminal to ask for the password on: give it on standard input "
"with --password-stdin."
msgstr ""
"Non c'è un terminale su cui chiedere la password: passala sullo standard "
"input con --password-stdin."

#, python-brace-format
msgctxt "cli.admin.owner_exists"
msgid ""
"{username} ({email}) is the forum's owner already; nothing was created, and "
"its password is as it was."
msgstr ""
"{username} ({email}) è già il proprietario del forum; non è stato creato "
"nulla, e la sua password è rimasta quella di prima."

msgctxt "cli.admin.password_again"
msgid "The same password again:"
msgstr "La stessa password, di nuovo:"

msgctxt "cli.admin.password_mismatch"
msgid "The two passwords differ; nothing was created."
msgstr "Le due password sono diverse; non è stato creato nulla."

msgctxt "cli.admin.password_prompt"
msgid "Password (at least 12 characters):"
msgstr "Password (almeno 12 caratteri):"

msgctxt "cli.admin.password_short"
msgid "The password needs at least 12 characters; nothing was created."
msgstr "La password richiede almeno 12 caratteri; non è stato creato nulla."

#, python-brace-format
msgctxt "cli.admin.unknown_action"
msgid "'{action}' is not something gpforum admin does: create or grant."
msgstr "'{action}' non è un'azione di gpforum admin: create o grant."

#, python-brace-format
msgctxt "cli.admin.unverified"
msgid ""
"{username} has not verified {email} yet, and can sign in once they have."
msgstr ""
"{username} non ha ancora verificato {email}, e potrà accedere dopo averlo "
"fatto."

#, python-brace-format
msgctxt "cli.admin.username_format"
msgid ""
"A username is lowercase letters, digits and _, starting with a letter, not "
"'{value}'."
msgstr ""
"Un nome utente ha lettere minuscole, cifre e _, e inizia con una lettera, "
"non '{value}'."

#, python-brace-format
msgctxt "cli.admin.username_length"
msgid "A username is 3 to 32 characters, not '{value}'."
msgstr "Un nome utente ha da 3 a 32 caratteri, non '{value}'."

#, python-brace-format
msgctxt "cli.admin.username_taken"
msgid ""
"There is already an account named {username}: make it the owner with gpforum "
"admin grant {username}."
msgstr ""
"Esiste già un account di nome {username}: rendilo proprietario con gpforum "
"admin grant {username}."

#, python-brace-format
msgctxt "cli.admin.would_create"
msgid ""
"Would create {username} ({email}) as the forum's owner; nothing was written."
msgstr ""
"Creerebbe {username} ({email}) come proprietario del forum; non è stato "
"scritto nulla."

#, python-brace-format
msgctxt "cli.admin.would_grant"
msgid "Would make {username} ({email}) the forum's owner; nothing was written."
msgstr ""
"Renderebbe {username} ({email}) proprietario del forum; non è stato scritto "
"nulla."

#, python-brace-format
msgctxt "cli.backup.archive_as_owner"
msgid ""
"Cannot copy the uploads in {root} as {user} ({said}): run the backup as "
"{owner}, who owns them, with {command}"
msgstr ""
"Impossibile copiare i file caricati in {root} come {user} ({said}): fai il "
"backup come {owner}, che ne è il proprietario, con {command}"

#, python-brace-format
msgctxt "cli.backup.archive_failed"
msgid ""
"Cannot copy the uploads in {root} ({said}): make every file and directory "
"in it readable by {user}, then run the backup again."
msgstr ""
"Impossibile copiare i file caricati in {root} ({said}): rendi leggibili a "
"{user} tutti i file e le directory che contiene, poi rifai il backup."

#, python-brace-format
msgctxt "cli.backup.attachments_many"
msgid "attachments: {count} files, {size}, from {root}"
msgstr "allegati: {count} file, {size}, da {root}"

#, python-brace-format
msgctxt "cli.backup.attachments_none"
msgid "attachments: none yet, in {root}"
msgstr "allegati: ancora nessuno, in {root}"

#, python-brace-format
msgctxt "cli.backup.attachments_one"
msgid "attachments: 1 file, {size}, from {root}"
msgstr "allegati: 1 file, {size}, da {root}"

#, python-brace-format
msgctxt "cli.backup.cannot_make"
msgid ""
"Cannot make {directory} ({reason}): make it for {user} first, with sudo "
"install -d -o {user} -m 700 {typed}"
msgstr ""
"Impossibile creare {directory} ({reason}): creala prima per {user}, con sudo "
"install -d -o {user} -m 700 {typed}"

#, python-brace-format
msgctxt "cli.backup.database"
msgid "database {database}: {size}, schema {schema}, PostgreSQL {server}"
msgstr "database {database}: {size}, schema {schema}, PostgreSQL {server}"

#, python-brace-format
msgctxt "cli.backup.database_bare"
msgid "database {database}: {size}, PostgreSQL {server}"
msgstr "database {database}: {size}, PostgreSQL {server}"

#, python-brace-format
msgctxt "cli.backup.done"
msgid "Backed up into {directory}"
msgstr "Backup fatto in {directory}"

#, python-brace-format
msgctxt "cli.backup.dump_failed"
msgid "pg_dump could not back up the database {database}: {said}"
msgstr ""
"pg_dump non è riuscito a fare il backup del database {database}: {said}"

#, python-brace-format
msgctxt "cli.backup.dump_older"
msgid ""
"pg_dump {client} cannot back up PostgreSQL {server}, which is newer: "
"install PostgreSQL {major}'s client programs, or name their pg_dump with "
"GPFORUM_PG_DUMP."
msgstr ""
"pg_dump {client} non può fare il backup di PostgreSQL {server}, che è più "
"recente: installa i programmi client di PostgreSQL {major}, o indica il "
"loro pg_dump con GPFORUM_PG_DUMP."

#, python-brace-format
msgctxt "cli.backup.in_attachments"
msgid ""
"{directory} is inside the attachment root {root}, which the backup copies: "
"name another with --to, such as --to /var/backups/gpforum."
msgstr ""
"{directory} è dentro la directory degli allegati {root}, che il backup "
"copia: indicane un'altra con --to, per esempio --to /var/backups/gpforum."

#, python-brace-format
msgctxt "cli.backup.in_code"
msgid ""
"{directory} is inside the code directory {root}, which an upgrade replaces: "
"name another with --to, such as --to /var/backups/gpforum."
msgstr ""
"{directory} è dentro la directory del codice {root}, che un aggiornamento "
"sostituisce: indicane un'altra con --to, per esempio --to "
"/var/backups/gpforum."

#, python-brace-format
msgctxt "cli.backup.next_check"
msgid "check that it can be restored, with {command}"
msgstr "verifica che si possa ripristinare, con {command}"

#, python-brace-format
msgctxt "cli.backup.no_attachments"
msgid "attachments: {root} does not exist, so the backup holds no uploads"
msgstr ""
"allegati: {root} non esiste, quindi il backup non contiene file caricati"

msgctxt "cli.backup.no_client"
msgid ""
"Cannot find PostgreSQL's pg_dump and pg_restore: install its client "
"programs, or name them with GPFORUM_PG_DUMP and GPFORUM_PG_RESTORE."
msgstr ""
"pg_dump e pg_restore di PostgreSQL non si trovano: installa i suoi programmi "
"client, o indicali con GPFORUM_PG_DUMP e GPFORUM_PG_RESTORE."

#, python-brace-format
msgctxt "cli.backup.no_words"
msgid "gpforum backup takes no '{word}': name the directory with --to {word}."
msgstr ""
"gpforum backup non accetta '{word}': indica la directory con --to {word}."

#, python-brace-format
msgctxt "cli.backup.not_directory"
msgid "{directory} is a file, not a directory: name a directory with --to."
msgstr ""
"{directory} è un file, non una directory: indica una directory con --to."

#, python-brace-format
msgctxt "cli.budgets.extra"
msgid "No longer in the code: {endpoints}"
msgstr "Non più nel codice: {endpoints}"

#, python-brace-format
msgctxt "cli.budgets.mismatched"
msgid "Other numbers than the code's: {endpoints}"
msgstr "Con numeri diversi da quelli del codice: {endpoints}"

#, python-brace-format
msgctxt "cli.budgets.missing"
msgid "Not in the database: {endpoints}"
msgstr "Assenti dal database: {endpoints}"

#, python-brace-format
msgctxt "cli.config.footer_file"
msgid "Set these in {file}, then try again."
msgstr "Impostale in {file}, poi riprova."

#, python-brace-format
msgctxt "cli.config.footer_shell"
msgid ""
"The shell's environment sets {variables}, which comes before {file}: "
"correct it there, or unset it, then try again."
msgstr ""
"L'ambiente della shell imposta {variables}, che ha la precedenza su "
"{file}: correggilo lì, oppure toglilo con unset, poi riprova."

#, python-brace-format
msgctxt "cli.env_file.malformed"
msgid ""
"Line {line} of {file} is not NAME=value: correct it, or start it with # to "
"leave it out."
msgstr ""
"La riga {line} di {file} non è NOME=valore: correggila, oppure falla "
"iniziare con # per escluderla."

#, python-brace-format
msgctxt "cli.env_file.missing"
msgid ""
"There is no {file}: correct the path given to --env-file, or make the file "
"from deploy/gpforum.env.example."
msgstr ""
"{file} non esiste: correggi il percorso dato a --env-file, oppure crea il "
"file da deploy/gpforum.env.example."

#, python-brace-format
msgctxt "cli.env_file.unreadable"
msgid ""
"Cannot read {file} ({reason}): run gpforum as the service's user, with sudo "
"-u gpforum, or as root."
msgstr ""
"Impossibile leggere {file} ({reason}): esegui gpforum come utente del "
"servizio, con sudo -u gpforum, oppure come root."

#, python-brace-format
msgctxt "cli.front_door.global_option"
msgid ""
"gpforum has no option {option}: a command's own options go after its name."
msgstr ""
"gpforum non ha l'opzione {option}: le opzioni di un comando vanno dopo il "
"suo nome."

msgctxt "cli.front_door.see_help"
msgid "gpforum help lists them all."
msgstr "gpforum help li elenca tutti."

#, python-brace-format
msgctxt "cli.front_door.unknown"
msgid "'{command}' is not a gpforum command."
msgstr "'{command}' non è un comando di gpforum."

msgctxt "cli.help.footer"
msgid ""
"gpforum help COMMAND explains one; gpforum help --all lists every command."
msgstr ""
"gpforum help COMANDO ne spiega uno; gpforum help --all li elenca tutti."

msgctxt "cli.help.footer_all"
msgid "gpforum help COMMAND explains one."
msgstr "gpforum help COMANDO ne spiega uno."

msgctxt "cli.help.group.check"
msgid "Check"
msgstr "Verifica"

msgctxt "cli.help.group.framework"
msgid "Mojolicious's and Minion's own"
msgstr "Comandi di Mojolicious e di Minion"

msgctxt "cli.help.group.maintain"
msgid "Maintain"
msgstr "Manutenzione"

msgctxt "cli.help.group.more"
msgid "Benchmarks, seeds, drills and evidence"
msgstr "Benchmark, dati di prova, esercitazioni ed evidenze"

msgctxt "cli.help.group.run"
msgid "Run"
msgstr "Esecuzione"

msgctxt "cli.help.group.setup"
msgid "Set up"
msgstr "Installazione"

#, python-brace-format
msgctxt "cli.help.settings_file"
msgid "Settings are read from {file}; the shell's environment comes first."
msgstr ""
"Le impostazioni si leggono da {file}; l'ambiente della shell ha la "
"precedenza."

#, python-brace-format
msgctxt "cli.help.settings_shell"
msgid "Settings come from the shell's environment: this host has no {file}."
msgstr ""
"Le impostazioni vengono dall'ambiente della shell: su questo host non c'è "
"{file}."

msgctxt "cli.help.usage"
msgid "Usage: gpforum [--env-file FILE] COMMAND [OPTIONS]"
msgstr "Uso: gpforum [--env-file FILE] COMANDO [OPZIONI]"

#, python-brace-format
msgctxt "cli.jobs.done"
msgid "{job}: checked"
msgstr "{job}: controllo fatto"

#, python-brace-format
msgctxt "cli.jobs.failed"
