msgstr "Applicata la migrazione {version}, {description}"

#, python-brace-format
msgctxt "cli.migrate.budgets"
msgid "synced the query budgets ({count} changed)"
msgstr "allineati i budget di query ({count} modificati)"

#, python-brace-format
msgctxt "cli.migrate.current"
msgid "Schema is current ({version})"
msgstr "Lo schema è aggiornato ({version})"

msgctxt "cli.migrate.next_apply"
msgid "gpforum migrate"
msgstr "gpforum migrate"

msgctxt "cli.migrate.next_owner"
msgid ""
"make the forum's owner, with gpforum admin create --email you@example.com "
"--username you"
msgstr ""
"crea il proprietario del forum, con gpforum admin create --email "
"tu@example.com --username tu"

#, python-brace-format
msgctxt "cli.migrate.next_restart"
msgid "restart the service on the new schema, with {restart}"
msgstr "riavvia il servizio sul nuovo schema, con {restart}"

msgctxt "cli.migrate.next_start"
msgid "gpforum start --foreground"
msgstr "gpforum start --foreground"

msgctxt "cli.migrate.one_mode"
msgid "Choose one of --plan, --apply and --check."
msgstr "Scegli uno tra --plan, --apply e --check."

#, python-brace-format
msgctxt "cli.migrate.partitions_many"
