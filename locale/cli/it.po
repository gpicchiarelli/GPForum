msgid "{variable} must be at least {minimum}, not {value}."
msgstr "{variable} deve essere almeno {minimum}, non {value}."

#, python-brace-format
msgctxt "config.at_most"
msgid "{variable} must be at most {maximum}, not {value}."
msgstr "{variable} deve essere al massimo {maximum}, non {value}."

