msgstr "Cache delle pagine pubbliche svuotata."

#, python-brace-format
msgctxt "admin.cache_purged_locally"
msgid ""
"Public page cache purged in the web processes only: the shared cache was "
"unreachable, so its entries expire within their TTL. Not reached: {tags}."
msgstr ""
"Cache delle pagine pubbliche svuotata solo nei processi web: la cache "
"condivisa non era raggiungibile, le sue voci scadono entro il loro TTL. Non "
"raggiunti: {tags}."

