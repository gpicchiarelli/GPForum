msgstr ""
"Il tuo account non ha un indirizzo email, quindi non c’è dove inviare un "
"messaggio di prova."

msgctxt "admin.mail_test_sent"
msgid "Test message sent to your address."
msgstr "Messaggio di prova inviato al tuo indirizzo."

msgctxt "admin.mail_test_transport_note"
msgid ""
"The test transport keeps messages in memory: a test reports success, but "
"nothing leaves this server."
msgstr ""
"Il trasporto di test tiene i messaggi in memoria: la prova riesce, ma nulla "
"esce da questo server."

