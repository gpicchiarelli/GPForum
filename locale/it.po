msgctxt "admin.cache_purge_hint"
msgid ""
"Drop every cached public page. Each is rendered again on its next visit; "
"nothing is lost."
msgstr ""
"Scarta ogni pagina pubblica in cache. Ciascuna viene ricreata alla visita "
"successiva; non si perde nulla."

